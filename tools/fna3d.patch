+/* Starts timing the next frame in a fresh render command buffer, first reading
+ * the oldest frame in the ring, whose slots this frame reuses. A frame the GPU
+ * hasn't finished by then is skipped.
+ */
+static void SDLGPU_INTERNAL_BeginTimedFrame(
+	SDLGPU_Renderer *renderer
+) {
+	Uint64 timestamps[2];
+	uint32_t slot;
+
+	renderer->timedFrame += 1;
+	slot = (renderer->timedFrame % GPU_TIMING_FRAMES) * 2;
+
+	if (	renderer->timedFrame >= GPU_TIMING_FRAMES &&
+		SDL_GetGPUTimestamps(
+			renderer->device,
+			renderer->timestampPool,
+			slot,
+			2,
+			timestamps
+		) &&
+		timestamps[1] >= timestamps[0]	)
+	{
+		renderer->gpuFrameTime = (float) (timestamps[1] - timestamps[0]) / 1000000.0f;
+	}
+
+	SDL_WriteGPUTimestamp(
+		renderer->renderCommandBuffer,
+		renderer->timestampPool,
+		slot
+	);
+}
