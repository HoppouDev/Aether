+// Timestamp Queries
+
+SDL_GPUQueryPool *SDL_CreateGPUTimestampQueryPool(
+    SDL_GPUDevice *device,
+    Uint32 count)
+{
+    CHECK_DEVICE_MAGIC(device, NULL);
+
+    CHECK_PARAM(count == 0) {
+        SDL_InvalidParamError("count");
+        return NULL;
+    }
+
+    if (device->CreateTimestampQueryPool == NULL) {
+        SDL_Unsupported();
+        return NULL;
+    }
+
+    return device->CreateTimestampQueryPool(
+        device->driverData,
+        count);
+}
+
+void SDL_WriteGPUTimestamp(
+    SDL_GPUCommandBuffer *command_buffer,
+    SDL_GPUQueryPool *pool,
+    Uint32 index)
+{
+    CHECK_PARAM(command_buffer == NULL) {
+        SDL_InvalidParamError("command_buffer");
+        return;
+    }
+    CHECK_PARAM(pool == NULL) {
+        SDL_InvalidParamError("pool");
+        return;
+    }
+
+    if (COMMAND_BUFFER_DEVICE->debug_mode) {
+        CHECK_COMMAND_BUFFER
+        CHECK_ANY_PASS_IN_PROGRESS("Cannot write a timestamp during a pass!", )
+    }
+
+    COMMAND_BUFFER_DEVICE->WriteTimestamp(
+        command_buffer,
+        pool,
+        index);
+}
+
+bool SDL_GetGPUTimestamps(
+    SDL_GPUDevice *device,
+    SDL_GPUQueryPool *pool,
+    Uint32 first,
+    Uint32 count,
+    Uint64 *nanoseconds)
+{
+    CHECK_DEVICE_MAGIC(device, false);
+
+    CHECK_PARAM(pool == NULL) {
+        SDL_InvalidParamError("pool");
+        return false;
+    }
+    CHECK_PARAM(nanoseconds == NULL) {
+        SDL_InvalidParamError("nanoseconds");
+        return false;
+    }
+
+    return device->GetTimestamps(
+        device->driverData,
+        pool,
+        first,
+        count,
+        nanoseconds);
+}
+
+void SDL_ReleaseGPUQueryPool(
+    SDL_GPUDevice *device,
+    SDL_GPUQueryPool *pool)
+{
+    CHECK_DEVICE_MAGIC(device, );
+
+    if (pool == NULL) {
+        return;
+    }
+
+    device->ReleaseQueryPool(
+        device->driverData,
+        pool);
+}
