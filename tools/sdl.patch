diff --git a/src/gpu/vulkan/SDL_gpu_vulkan.c b/src/gpu/vulkan/SDL_gpu_vulkan.c
index a7d8d57d7..72ca3ebfe 100644
--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -9743,6 +9743,130 @@ static SDL_GPUCommandBuffer *VULKAN_AcquireCommandBuffer(
     return (SDL_GPUCommandBuffer *)commandBuffer;
 }

+// Timestamp Queries
+
+typedef struct VulkanQueryPool
+{
+    VkQueryPool queryPool;
+    Uint32 count;
+} VulkanQueryPool;
+
+static SDL_GPUQueryPool *VULKAN_CreateTimestampQueryPool(
+    SDL_GPURenderer *driverData,
+    Uint32 count)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VkQueryPoolCreateInfo createInfo;
+    VkQueryPool queryPool;
+    VkResult result;
+    VulkanQueryPool *pool;
+
+    // Graphics and compute queues all support timestamps when this is set
+    if (!renderer->physicalDeviceProperties.properties.limits.timestampComputeAndGraphics) {
+        SDL_SetError("This device doesn't support GPU timestamps");
+        return NULL;
+    }
+
+    SDL_zero(createInfo);
+    createInfo.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    createInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    createInfo.queryCount = count;
+
+    result = renderer->vkCreateQueryPool(
+        renderer->logicalDevice,
+        &createInfo,
+        NULL,
+        &queryPool);
+    CHECK_VULKAN_ERROR_AND_RETURN(result, vkCreateQueryPool, NULL);
+
+    pool = SDL_malloc(sizeof(VulkanQueryPool));
+    pool->queryPool = queryPool;
+    pool->count = count;
+    return (SDL_GPUQueryPool *)pool;
+}
+
+static void VULKAN_WriteTimestamp(
+    SDL_GPUCommandBuffer *commandBuffer,
+    SDL_GPUQueryPool *pool,
+    Uint32 index)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanRenderer *renderer = vulkanCommandBuffer->renderer;
+    VulkanQueryPool *vulkanPool = (VulkanQueryPool *)pool;
+
+    if (index >= vulkanPool->count) {
+        SDL_SetError("Timestamp index %" SDL_PRIu32 " is outside the pool", index);
+        return;
+    }
+
+    // A slot must be reset before each write; resetting is only allowed outside passes
+    renderer->vkCmdResetQueryPool(
+        vulkanCommandBuffer->commandBuffer,
+        vulkanPool->queryPool,
+        index,
+        1);
+    renderer->vkCmdWriteTimestamp(
+        vulkanCommandBuffer->commandBuffer,
+        VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+        vulkanPool->queryPool,
+        index);
+}
+
+static bool VULKAN_GetTimestamps(
+    SDL_GPURenderer *driverData,
+    SDL_GPUQueryPool *pool,
+    Uint32 first,
+    Uint32 count,
+    Uint64 *nanoseconds)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanQueryPool *vulkanPool = (VulkanQueryPool *)pool;
+    double period = renderer->physicalDeviceProperties.properties.limits.timestampPeriod;
+    VkResult result;
+    Uint32 i;
+
+    if (first >= vulkanPool->count || count > vulkanPool->count - first) {
+        SDL_SetError("Timestamp range is outside the pool");
+        return false;
+    }
+
+    result = renderer->vkGetQueryPoolResults(
+        renderer->logicalDevice,
+        vulkanPool->queryPool,
+        first,
+        count,
+        count * sizeof(Uint64),
+        nanoseconds,
+        sizeof(Uint64),
+        VK_QUERY_RESULT_64_BIT);
+    if (result == VK_NOT_READY) {
+        return false;
+    }
+    CHECK_VULKAN_ERROR_AND_RETURN(result, vkGetQueryPoolResults, false);
+
+    // Ticks to nanoseconds
+    for (i = 0; i < count; i += 1) {
+        nanoseconds[i] = (Uint64)((double)nanoseconds[i] * period);
+    }
+    return true;
+}
+
+static void VULKAN_ReleaseQueryPool(
+    SDL_GPURenderer *driverData,
+    SDL_GPUQueryPool *pool)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanQueryPool *vulkanPool = (VulkanQueryPool *)pool;
+
+    // shortcut: waits for the whole GPU rather than deferring the destroy; fine for long-lived pools
+    VULKAN_Wait(driverData);
+    renderer->vkDestroyQueryPool(
+        renderer->logicalDevice,
+        vulkanPool->queryPool,
+        NULL);
+    SDL_free(vulkanPool);
+}
+
 static bool VULKAN_QueryFence(
     SDL_GPURenderer *driverData,
     SDL_GPUFence *fence)
