+/* Timestamp Queries (local addition: not part of upstream SDL) */
+
+/**
+ * An opaque handle representing a pool of GPU timestamp queries.
+ *
+ * Used for measuring how long work takes on the GPU: write a timestamp into
+ * two slots around some commands, then read both once the command buffer has
+ * finished.
+ *
+ * \sa SDL_CreateGPUTimestampQueryPool
+ * \sa SDL_WriteGPUTimestamp
+ * \sa SDL_GetGPUTimestamps
+ * \sa SDL_ReleaseGPUQueryPool
+ */
+typedef struct SDL_GPUQueryPool SDL_GPUQueryPool;
+
+/**
+ * Creates a pool of GPU timestamp queries.
+ *
+ * Only the Vulkan backend supports timestamp queries.
+ *
+ * \param device a GPU context.
+ * \param count the number of timestamp slots in the pool.
+ * \returns a query pool, or NULL on failure (including an unsupported
+ *          backend or device); call SDL_GetError() for more information.
+ */
+extern SDL_DECLSPEC SDL_GPUQueryPool * SDLCALL SDL_CreateGPUTimestampQueryPool(
+    SDL_GPUDevice *device,
+    Uint32 count);
+
+/**
+ * Writes the GPU's time into a slot of a timestamp query pool once all the
+ * commands recorded before it in the command buffer have finished.
+ *
+ * Must be called outside of any render, compute or copy pass.
+ *
+ * \param command_buffer a command buffer.
+ * \param pool a timestamp query pool.
+ * \param index the slot to write.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_WriteGPUTimestamp(
+    SDL_GPUCommandBuffer *command_buffer,
+    SDL_GPUQueryPool *pool,
+    Uint32 index);
+
+/**
+ * Reads timestamps from a query pool, in nanoseconds from an arbitrary point.
+ *
+ * Only differences between timestamps are meaningful. This does not wait for
+ * the GPU.
+ *
+ * \param device a GPU context.
+ * \param pool a timestamp query pool.
+ * \param first the first slot to read.
+ * \param count the number of slots to read.
+ * \param nanoseconds receives count timestamps.
+ * \returns true if every slot was available, false if any is not ready yet or
+ *          on failure; call SDL_GetError() for more information.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_GetGPUTimestamps(
+    SDL_GPUDevice *device,
+    SDL_GPUQueryPool *pool,
+    Uint32 first,
+    Uint32 count,
+    Uint64 *nanoseconds);
+
+/**
+ * Releases a query pool, waiting for the GPU to finish any work using it.
+ *
+ * \param device a GPU context.
+ * \param pool a query pool to release.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_ReleaseGPUQueryPool(
+    SDL_GPUDevice *device,
+    SDL_GPUQueryPool *pool);
+
