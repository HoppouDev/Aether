<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ModProjectName</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AetherUseApi>true</AetherUseApi>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- dotnet run and dotnet watch (./aether watch) start the game through the launcher. -->
    <RunCommand>$(MSBuildProjectDirectory)/aether</RunCommand>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <Import Project="build/Aether.Mod.targets" />
</Project>
