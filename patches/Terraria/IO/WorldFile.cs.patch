+    internal static bool ReportContentLoadError()
+    {
+        if (LastThrownLoadException is not ContentSaveException error)
+        {
+            return false;
+        }
+        Aether.GameLog.Terraria.Error("{Text:l}", $"{Main.worldPathName}: {error.Message}");
+        WorldGen.worldBackup = false;
+        Main.statusText = error.Message;
+        Main.menuMode = 15;
+        return true;
+    }
+
+    internal static bool CanRecoverBackup(string path, bool cloud)
+    {
+        string backup = path + ".bak";
+        return FileUtilities.Exists(backup, cloud) &&
+            (cloud || ItemSave.CanRecover(path, ItemSave.Kind.World) && ItemSave.CanRecover(backup, ItemSave.Kind.World));
+    }
+
+    internal static bool UsesPersistentBackup => ClientContent.HasPersistentNpcs && !Main.ActiveWorldFileData.IsCloudSave;
+
+    internal static void LoadPersistentBackup()
+    {
+        string path = Main.worldPathName;
+        string temporary = path + "." + Guid.NewGuid().ToString("N") + ".recovery";
+        try
+        {
+            ItemSave.CheckCompatibility(path, ItemSave.Kind.World);
+            byte[] contents = File.ReadAllBytes(path + ".bak");
+            LoadWorldCore(path + ".bak", contents);
+            if (WorldGen.loadFailed)
+                return;
+
+            using (var stream = new FileStream(temporary, FileMode.CreateNew))
+            {
+                stream.Write(contents);
+                stream.Flush(flushToDisk: true);
+            }
+            if (File.Exists(path))
+                File.Copy(path, path + ".bad", overwrite: true);
+            File.Move(temporary, path, overwrite: true);
+        }
+        catch (Exception error)
+        {
+            LastThrownLoadException = error;
+            WorldGen.loadFailed = true;
+        }
+        finally
+        {
+            File.Delete(temporary);
+        }
+    }
