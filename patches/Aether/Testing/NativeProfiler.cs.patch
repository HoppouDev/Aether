+using System;
+using System.Runtime.InteropServices;
+
+namespace Aether.Testing;
+
+/// <summary>
+/// Aether's allocation profiler (tools/aether/profiler/aether_profiler.c), when the game was started
+/// with it (`aether run --profile`): it records each managed allocation's class, size and call stack
+/// between <see cref="Start" /> and <see cref="Stop" />, on every thread, and writes a report of the
+/// allocation sites and the methods that allocate the most. The control server's <c>profile</c>
+/// command drives it.
+/// </summary>
+public static unsafe class NativeProfiler
+{
+    private static bool _loaded;
+
+    private static delegate* unmanaged<int> _available;
+
+    private static delegate* unmanaged<void> _start;
+
+    private static delegate* unmanaged<void> _stop;
+
+    private static delegate* unmanaged<byte*, int, int, int> _report;
+
+    /// <summary>Whether the profiler was loaded into the game.</summary>
+    public static bool Available
+    {
+        get
+        {
+            if (!_loaded)
+            {
+                _loaded = true;
+                Load();
+            }
+            return _available != null && _available() != 0;
+        }
+    }
+
+    // .NET loaded the profiler privately from CORECLR_PROFILER_PATH; loading the same path again
+    // gives the same library, whose exports this calls.
+    private static void Load()
+    {
+        string path = Environment.GetEnvironmentVariable("CORECLR_PROFILER_PATH");
+        if (string.IsNullOrEmpty(path) || !NativeLibrary.TryLoad(path, out var library))
+        {
+            return;
+        }
+        if (NativeLibrary.TryGetExport(library, "aether_profiler_available", out var available) && NativeLibrary.TryGetExport(library, "aether_profiler_start", out var start) && NativeLibrary.TryGetExport(library, "aether_profiler_stop", out var stop) && NativeLibrary.TryGetExport(library, "aether_profiler_report", out var report))
+        {
+            _available = (delegate* unmanaged<int>)available;
+            _start = (delegate* unmanaged<void>)start;
+            _stop = (delegate* unmanaged<void>)stop;
+            _report = (delegate* unmanaged<byte*, int, int, int>)report;
+        }
+    }
+
+    /// <summary>Forgets what was collected and starts collecting (call from the main thread, which the report tells apart).</summary>
+    public static void Start()
+    {
+        _start();
+    }
+
+    public static void Stop()
+    {
+        _stop();
+    }
+
+    /// <summary>Writes the top sites and methods to path, per frame over frames; false if it can't be written.</summary>
+    public static bool Report(string path, int top, int frames)
+    {
+        IntPtr text = Marshal.StringToCoTaskMemUTF8(path);
+        try
+        {
+            return _report((byte*)text, top, frames) == 0;
+        }
+        finally
+        {
+            Marshal.FreeCoTaskMem(text);
+        }
+    }
+}
