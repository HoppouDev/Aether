--- /dev/null
+++ b/Aether/Graphics/EntityMotion/LocalMovementPreview.cs
@@ -0,0 +1,86 @@
+using Terraria;
+using Microsoft.Xna.Framework;
+using System;
+using Microsoft.Xna.Framework.Input;
+using Terraria.GameInput;
+
+namespace Aether.Graphics.EntityMotion;
+
+internal static class LocalMovementPreview
+{
+    // Sample input without consuming trigger edges or calling Player.Update.
+    // Special movement retains the simulation's velocity instead of duplicating
+    // mount, grapple, dash, swimming or combat state machines in the renderer.
+    internal static Vector2 Velocity(Player player)
+    {
+        Vector2 velocity=player.velocity;
+        if(!Terraria.FocusHelper.AllowInputProcessing||PlayerInput.WritingText||Main.drawingPlayerChat||player.CCed||
+            player.mount.Active||player.pulley||player.grapCount>0||PlayerInput.UsingGamepadUI||Main.ingameOptionsWindow||Main.inFancyUI)return velocity;
+        bool left,right,jump;
+        if(PlayerInput.UsingGamepad)
+        {
+            left=PlayerInput.Triggers.Current.Left;right=PlayerInput.Triggers.Current.Right;jump=PlayerInput.Triggers.Current.Jump;
+            for(int i=0;i<4;i++)
+            {
+                var pad=Aether.Testing.SyntheticInput.GamePad(i, GamePad.GetState((PlayerIndex)i));if(!pad.IsConnected)continue;
+                left=pad.ThumbSticks.Left.X<-.2f||BoundPad(pad,"Left");
+                right=pad.ThumbSticks.Left.X>.2f||BoundPad(pad,"Right");jump=BoundPad(pad,"Jump");break;
+            }
+        }
+        else
+        {
+            var keyboard = Aether.Testing.SyntheticInput.Keyboard(Keyboard.GetState());
+            var mouse = Aether.Testing.SyntheticInput.Mouse(Mouse.GetState());
+            left=BoundKey(keyboard,mouse,"Left");right=BoundKey(keyboard,mouse,"Right");jump=BoundKey(keyboard,mouse,"Jump");
+        }
+        int desired=(right?1:0)-(left?1:0),simulated=(player.controlRight?1:0)-(player.controlLeft?1:0);
+        if(desired!=simulated)
+        {
+            if(desired==0)velocity.X=Math.Sign(velocity.X)*Math.Max(0,Math.Abs(velocity.X)-player.runSlowdown);
+            else velocity.X=GraphicsMath.Clamp(velocity.X+desired*player.runAcceleration,
+                -Math.Max(player.accRunSpeed,Math.Abs(velocity.X)),Math.Max(player.accRunSpeed,Math.Abs(velocity.X)));
+        }
+        if(jump&&!player.controlJump&&player.releaseJump&&velocity.Y==0&&
+            Collision.SolidCollision(player.position+Vector2.UnitY,player.width,player.height,true))
+            velocity.Y=-(Player.jumpSpeed+player.jumpSpeedBoost)*player.gravDir;
+        return velocity;
+    }
+    private static bool BoundKey(KeyboardState keyboard,MouseState mouse,string trigger)
+    {
+        if(!PlayerInput.CurrentProfile.InputModes[InputMode.Keyboard].KeyStatus.TryGetValue(trigger,out var bindings))return false;
+        foreach(string name in bindings)
+        {
+            if(Enum.TryParse<Keys>(name,out var key)&&keyboard.IsKeyDown(key))return true;
+            if(name=="Mouse1"&&mouse.LeftButton==ButtonState.Pressed||name=="Mouse2"&&mouse.RightButton==ButtonState.Pressed||
+                name=="Mouse3"&&mouse.MiddleButton==ButtonState.Pressed||name=="Mouse4"&&mouse.XButton1==ButtonState.Pressed||
+                name=="Mouse5"&&mouse.XButton2==ButtonState.Pressed)return true;
+        }
+        return false;
+    }
+    private static bool BoundPad(GamePadState pad,string trigger)
+    {
+        if(!PlayerInput.CurrentProfile.InputModes[InputMode.XBoxGamepad].KeyStatus.TryGetValue(trigger,out var bindings))return false;
+        foreach(string name in bindings)if(Enum.TryParse<Buttons>(name,out var key)&&pad.IsButtonDown(key))return true;
+        return false;
+    }
+    internal static Vector2 Clip(Player player,Vector2 offset)
+    {
+        if(player.ghost||offset==Vector2.Zero||!MotionHistory.Finite(offset)||
+            Collision.SolidCollision(player.position,player.width,player.height))return offset;
+        bool platforms=offset.Y>0&&!player.controlDown&&!Collision.SolidCollision(player.position,player.width,player.height,true);
+        int segments=GraphicsMath.Clamp((int)Math.Ceiling(offset.Length()/8),1,64);
+        float safe=0;
+        for(int segment=1;segment<=segments;segment++)
+        {
+            float blocked=(float)segment/segments;
+            if(!Collision.SolidCollision(player.position+offset*blocked,player.width,player.height,platforms)){safe=blocked;continue;}
+            for(int i=0;i<8;i++)
+            {
+                float mid=(safe+blocked)*.5f;
+                if(Collision.SolidCollision(player.position+offset*mid,player.width,player.height,platforms))blocked=mid;else safe=mid;
+            }
+            return offset*safe;
+        }
+        return offset;
+    }
+}
