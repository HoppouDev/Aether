+using Terraria;
+using System.Threading;
+using Microsoft.Xna.Framework;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace Aether.Graphics.Terrain;
+
+// CPU publication cache only. A stored result is NEVER permission to draw:
+// TryGetValidated must succeed for the current render frame before GPU use.
+public sealed class ChunkGeometryCache
+{
+    public const int MaximumChunks = 128;
+    private readonly int owner = Thread.CurrentThread.ManagedThreadId;
+    private readonly ChunkTracker tracker;
+    private readonly ChunkMemoryBudget budget;
+    private readonly Dictionary<ChunkKey, Entry> entries = new();
+    private long access;
+    internal bool ReuseBinding { get; set; }
+    private Entry? lastEntry;
+    private long lastFrame, lastStamp;
+    public long BindingHits { get; private set; }
+    public long Bytes { get; private set; }
+    public int Count => entries.Count;
+    public long Validations { get; private set; }
+    public event Action<ChunkKey>? Evicted;
+    public ChunkGeometryCache(ChunkTracker tracker, ChunkMemoryBudget budget)
+    { this.tracker = tracker; this.budget = budget; }
+    internal void CheckOwner()
+    { if (Thread.CurrentThread.ManagedThreadId != owner) throw new InvalidOperationException("Chunk publication belongs to the main thread"); }
+    public IEnumerable<PreparedChunk> CurrentResults()
+    {
+        CheckOwner();
+        foreach (var entry in entries.Values)
+            if (tracker.IsCurrent(entry.Result.Key, entry.Result.Version)) yield return entry.Result;
+    }
+    public bool ReclaimForJob(long bytes)
+    {
+        CheckOwner();
+        if (bytes <= 0 || bytes > ChunkMemoryBudget.Limit) return false;
+        while (budget.Used > ChunkMemoryBudget.Limit - bytes) if (!RemoveOldest()) return false;
+        return true;
+    }
+    public bool Publish(PreparedChunk result)
+    {
+        CheckOwner();
+        if (result.Geometry is null || !tracker.IsCurrent(result.Key, result.Version)) return false;
+        Remove(result.Key);
+        long bytes = result.Geometry.Bytes + (result.Walls?.Bytes ?? 0) + 128L;
+        while (entries.Count >= MaximumChunks) RemoveOldest();
+        while (!budget.TryReserve(bytes)) if (!RemoveOldest()) return false;
+        if (!tracker.Publish(result)) { budget.Release(bytes); return false; }
+        // Prefetched chunks may never have been drawn. Stamp publication too,
+        // so a reused dictionary slot cannot make a fresh result look oldest.
+        entries[result.Key] = new Entry(result, bytes) { LastUse = ++access }; Bytes += bytes; return true;
+    }
+    public bool TryPeek(ChunkKey key, out PreparedChunk? result)
+    {
+        CheckOwner(); result = null;
+        if (!entries.TryGetValue(key, out var entry)) return false;
+        if (!tracker.IsCurrent(key, entry.Result.Version)) { Remove(key); return false; }
+        result = entry.Result; return true;
+    }
+    public bool TryGetValidated(ChunkKey key, long renderFrame, Func<ChunkKey, ulong?> fingerprint, out PreparedChunk? result)
+    {
+        CheckOwner(); result = null;
+        if (ReuseBinding && lastEntry is not null && lastEntry.Result.Key == key &&
+            lastFrame == renderFrame && lastStamp == tracker.ChangeStamp)
+        {
+            lastEntry.LastUse = ++access; result = lastEntry.Result; BindingHits++; return true;
+        }
+        if (!TryPeek(key, out var prepared)) return false;
+        Entry entry = entries[key];
+        if (entry.ValidatedFrame != renderFrame)
+        {
+            if (!TerrainPreparationBudget.HasTime) return false;
+            long start = Stopwatch.GetTimestamp(); ulong? current;
+            try { current = fingerprint(key); }
+            finally { TerrainPreparationBudget.Charge(Stopwatch.GetTimestamp() - start); }
+            // Missing/unframed data must fall back without blessing old geometry.
+            if (current is null) return false;
+            if (current != prepared!.Fingerprint)
+            { tracker.Invalidate(key); Remove(key); return false; }
+            if (!tracker.IsCurrent(key, prepared!.Version)) { Remove(key); return false; }
+            entry.ValidatedFrame = renderFrame; Validations++;
+        }
+        entry.LastUse = ++access; result = prepared;
+        if (ReuseBinding) { lastEntry = entry; lastFrame = renderFrame; lastStamp = tracker.ChangeStamp; }
+        return true;
+    }
+    public void Clear()
+    {
+        CheckOwner();
+        foreach (var key in new List<ChunkKey>(entries.Keys)) Remove(key);
+    }
+    public void Remove(ChunkKey key)
+    {
+        CheckOwner();
+        if (!entries.TryGetValue(key, out var entry)) return;
+        entries.Remove(key);
+        if (ReferenceEquals(entry, lastEntry)) lastEntry = null;
+        budget.Release(entry.Bytes); Bytes -= entry.Bytes; Evicted?.Invoke(key);
+    }
+    private bool RemoveOldest()
+    {
+        ChunkKey oldest = default; long stamp = long.MaxValue; bool found = false;
+        foreach (var pair in entries)
+            if (pair.Value.LastUse < stamp) { oldest = pair.Key; stamp = pair.Value.LastUse; found = true; }
+        if (found)
+        {
+            var version = entries[oldest].Result.Version;
+            Remove(oldest);
+            // A matching fingerprint in the scan table must not suppress future
+            // preparation after residency eviction. Leave newer jobs untouched.
+            if (tracker.IsCurrent(oldest, version)) tracker.Invalidate(oldest);
+        }
+        return found;
+    }
+    private sealed class Entry(PreparedChunk result, long bytes)
+    {
+        public readonly PreparedChunk Result = result;
+        public readonly long Bytes = bytes;
+        public long ValidatedFrame = long.MinValue, LastUse;
+    }
+}
