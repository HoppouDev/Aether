--- /dev/null
+++ b/Aether/Graphics/Terrain/TerrainSnapshotPump.cs
@@ -0,0 +1,182 @@
+using Terraria;
+using System.Threading;
+using Microsoft.Xna.Framework;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace Aether.Graphics.Terrain;
+
+
+// Adapter boundary: this is the only component that reads live TileData. Worker
+// code lives in ChunkPreparationQueue and receives immutable SnapshotTile arrays.
+public static class TerrainSnapshotPump
+{
+    private readonly record struct Scan(ulong Hash, ChunkVersion Version, uint Update);
+    private readonly record struct Candidate(ChunkKey Key, long Priority);
+
+    // Section notifications may first touch this type on a network thread.
+    // Bind owner-affine state only from the render-thread entry point.
+    private static readonly ChunkMemoryBudget memory = new();
+    private static ChunkGeometryCache? cache;
+    private static long renderFrame;
+    private static ChunkTracker tracker = null!;
+    private static ChunkPreparationQueue queue = null!;
+    private static readonly SnapshotTile[] scratch = new SnapshotTile[ChunkSnapshot.TileCount];
+    private static readonly Dictionary<ChunkKey, Scan> scanned = new();
+    private static readonly ChunkInvalidationInbox edits = new();
+    private static readonly ChunkSectionInbox<WorldSections> sectionChanges = new();
+    private static readonly List<Candidate> candidates = new();
+    private static Tile[,]? world;
+    private static readonly ChunkAssetBinding<Terraria.GameContent.AssetSourceController, Terraria.IO.ResourcePackList> assetBinding = new(
+        static (controller, changed) => controller.OnResourcePackChange += changed,
+        static (controller, changed) => controller.OnResourcePackChange -= changed);
+    private static long generation, assets;
+    private static volatile bool enabled;
+    private static int cursor;
+    private static Microsoft.Xna.Framework.Vector2 lastCenter, travelDirection;
+
+    public static long ValidationStamp => tracker?.ChangeStamp ?? 0;
+    public static bool CanReuseBinding(long stamp)
+    {
+        cache?.CheckOwner();
+        return enabled && tracker.ChangeStamp == stamp && ReferenceEquals(world, Main.tile) &&
+            assetBinding.Matches(Main.AssetSourceController, assets) && !edits.HasPending && !sectionChanges.HasPending;
+    }
+
+    public static void BeginRenderFrame() => renderFrame++;
+    public static bool TryGetValidated(ChunkKey key, out PreparedChunk? result)
+    {
+        result = null;
+        if (!enabled || cache is null) return false;
+        cache.CheckOwner();
+        if (!ReferenceEquals(world, Main.tile) || !assetBinding.Matches(Main.AssetSourceController, assets)) return false;
+        if (edits.HasPending || sectionChanges.HasPending)
+        {
+            if (!TerrainPreparationBudget.HasTime) return false;
+            long start = Stopwatch.GetTimestamp();
+            try { ApplyNotifications(); }
+            finally { TerrainPreparationBudget.Charge(Stopwatch.GetTimestamp() - start); }
+        }
+        return cache.TryGetValidated(key, renderFrame, CaptureFingerprint, out result);
+    }
+    public static ChunkGeometryCache? GeometryCache => enabled ? cache : null;
+    public static ChunkVersion CurrentEpoch => new(generation, assets, 0);
+    private static void ApplyNotifications()
+    {
+        bool complete = sectionChanges.Drain(static (sectionX, sectionY, owner) =>
+        {
+            if (!ReferenceEquals(owner, Main.sectionManager)) return;
+            int x = sectionX * 200, y = sectionY * 150;
+            var first = ChunkKey.FromTile(x - 1, y - 1); var last = ChunkKey.FromTile(x + 200, y + 150);
+            for (int cx = first.X; cx <= last.X; cx++) for (int cy = first.Y; cy <= last.Y; cy++) tracker.Invalidate(new(cx, cy));
+        });
+        if (!complete || !edits.Drain(Main.tile, tracker.Invalidate)) Reset(Main.tile);
+    }
+    private static ulong? CaptureFingerprint(ChunkKey key) => Capture(key) ? ChunkSnapshot.Hash(scratch) : null;
+    public static void InvalidateSection(WorldSections owner, int x, int y)
+    { if (enabled) sectionChanges.Invalidate(owner,x,y); }
+    public static void InvalidateTile(Tile[,] owner, int x, int y, TerrainDirtyLayers layers = TerrainDirtyLayers.All)
+    { if (enabled) edits.InvalidateTile(owner, x, y, layers); }
+    private static void Reset(Tile[,]? next)
+    {
+        cache?.Clear();
+        edits.Bind(next);
+        sectionChanges.Clear();
+        queue.CancelPending();
+        generation++;
+        tracker.Reset(generation, assets);
+        scanned.Clear(); candidates.Clear(); cursor = 0;
+        world = next;
+    }
+    public static void BeginFrame(bool requested)
+    {
+        if (!requested || Main.gameMenu || WorldGen.generatingWorld)
+        {
+            if (enabled) Reset(null);
+            assetBinding.Bind(null);
+            queue?.Pump();
+            enabled = false; return;
+        }
+        tracker ??= new();
+        queue ??= new(tracker, memory);
+        cache ??= new(tracker, memory);
+        if (queue.UseCompute != ChunkComputeMode.Requested || cache.ReuseBinding != ChunkFastDraw.Enabled)
+        {
+            Reset(Main.tile);
+            queue.UseCompute = ChunkComputeMode.Requested;
+            cache.ReuseBinding = ChunkFastDraw.Enabled;
+        }
+        enabled = true;
+        long start = Stopwatch.GetTimestamp();
+        try
+        {
+            assetBinding.Bind(Main.AssetSourceController);
+            long nextAssets = assetBinding.Revision;
+            if (!ReferenceEquals(world, Main.tile) || assets != nextAssets)
+            { assets = nextAssets; Reset(Main.tile); }
+            ApplyNotifications();
+            queue.Pump();
+            for (int i=0;i<4 && HasTime(start) && queue.TryTake(out var result);i++)
+                cache.Publish(result!);
+            candidates.Clear();
+            var position=Main.Camera.ScaledPosition; var size=Main.Camera.ScaledSize;
+            int maxX=(Main.maxTilesX-1)/64,maxY=(Main.maxTilesY-1)/64;
+            int left=GraphicsMath.Clamp((int)Math.Floor(position.X/1024)-2,0,maxX),top=GraphicsMath.Clamp((int)Math.Floor(position.Y/1024)-2,0,maxY);
+            int right=GraphicsMath.Clamp((int)Math.Floor((position.X+size.X)/1024)+2,0,maxX),bottom=GraphicsMath.Clamp((int)Math.Floor((position.Y+size.Y)/1024)+2,0,maxY);
+            double centerX=(position.X+size.X/2)/1024,centerY=(position.Y+size.Y/2)/1024;
+            var center = new Microsoft.Xna.Framework.Vector2((float)centerX,(float)centerY);
+            var delta = center-lastCenter;
+            if(delta.LengthSquared()>.000001f)travelDirection=Microsoft.Xna.Framework.Vector2.Normalize(delta);
+            lastCenter=center;
+            int viewLeft=(int)Math.Floor(position.X/1024),viewRight=(int)Math.Floor((position.X+size.X)/1024);
+            int viewTop=(int)Math.Floor(position.Y/1024),viewBottom=(int)Math.Floor((position.Y+size.Y)/1024);
+            for(int x=left;x<=right;x++)for(int y=top;y<=bottom;y++)
+            {
+                double dx=x+.5-centerX,dy=y+.5-centerY;
+                bool visible=x>=viewLeft&&x<=viewRight&&y>=viewTop&&y<=viewBottom;
+                double ahead=dx*travelDirection.X+dy*travelDirection.Y;
+                candidates.Add(new Candidate(new(x,y),(visible?0:1000000)+(long)((dx*dx+dy*dy-ahead*.5)*1024)));
+            }
+            candidates.Sort((a,b)=>a.Priority.CompareTo(b.Priority));
+            int count=candidates.Count;
+            for(int inspected=0;inspected<count && HasTime(start);inspected++)
+            {
+                if(cursor>=count)cursor=0;
+                var candidate=candidates[cursor++];
+                ChunkVersion version=tracker.Current(candidate.Key);
+                if(scanned.TryGetValue(candidate.Key,out var previous)&&previous.Update==Main.GameUpdateCount&&previous.Version==version)continue;
+                if(!Capture(candidate.Key))continue;
+                ulong hash=ChunkSnapshot.Hash(scratch);
+                if(scanned.TryGetValue(candidate.Key,out previous)&&previous.Hash==hash&&previous.Version==version)
+                { scanned[candidate.Key] = new Scan(hash, version, Main.GameUpdateCount);continue; }
+                if(scanned.ContainsKey(candidate.Key)){tracker.Invalidate(candidate.Key);version=tracker.Current(candidate.Key);}
+                var snapshot=new ChunkSnapshot(candidate.Key,version,scratch);
+                cache.ReclaimForJob(snapshot.Bytes + ChunkGeometry.MaximumBytes + ChunkWallGeometry.MaximumBytes + 128L);
+                if(queue.Enqueue(snapshot,candidate.Priority))scanned[candidate.Key] = new Scan(hash, version, Main.GameUpdateCount);
+            }
+            queue.Pump();
+        }
+        finally { TerrainPreparationBudget.Charge(Stopwatch.GetTimestamp()-start); }
+    }
+    private static bool HasTime(long start) => Stopwatch.GetTimestamp()-start < TerrainPreparationBudget.RemainingTicks;
+    private static bool Capture(ChunkKey key)
+    {
+        int originX=key.X*64-1,originY=key.Y*64-1;
+        for(int x=0;x<ChunkSnapshot.Side;x++)for(int y=0;y<ChunkSnapshot.Side;y++)
+        {
+            int tx=originX+x,ty=originY+y,index=x*ChunkSnapshot.Side+y;
+            if(tx<0||ty<0||tx>=Main.maxTilesX||ty>=Main.maxTilesY||!Main.sectionManager.TileLoaded(tx,ty))
+            {scratch[index]=default;continue;}
+            if(!Main.sectionManager.SectionFramed(Netplay.GetSectionX(tx),Netplay.GetSectionY(ty)))return false;
+            Tile tile = Main.tile[tx, ty];
+            if (tile == null)
+            {
+                scratch[index] = default;
+                continue;
+            }
+            scratch[index]=new SnapshotTile(tile.type,tile.wall,tile.frameX,tile.frameY,tile.sTileHeader,tile.bTileHeader,tile.bTileHeader2,tile.bTileHeader3,tile.liquid);
+        }
+        return true;
+    }
+}
