+using Terraria;
+using System.Threading;
+using Microsoft.Xna.Framework;
+using System;
+
+namespace Aether.Graphics.Terrain;
+
+// Process-fixed experiment switch. It never changes the renderer selection.
+public static class ChunkFastDraw
+{
+    public static bool Enabled => GraphicsSettings.FastTerrain;
+
+    // Start with plain dirt/stone only. Wiring is irrelevant to their geometry;
+    // paint, actuation, slopes, half blocks and block coatings remain compatible.
+    public static bool IsPlain(ushort type, ushort header, byte header3) =>
+        type <= 1 && (header & (31 | 32 | 64 | 1024 | 2048 | 0x7000)) == 32 && (header3 & 0xa0) == 0;
+}
