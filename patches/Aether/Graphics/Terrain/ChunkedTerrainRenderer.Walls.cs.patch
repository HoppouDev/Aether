+    public void BeginWallPass(int firstX,int lastX,int firstY,int lastY)
+    {
+        wallRuns.Clear(); wallLightReady=wallLightUploaded=false;
+        wallLeft=Math.Max(0,firstX); wallTop=Math.Max(0,firstY);
