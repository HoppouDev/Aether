+    private int DrawWallRun(WallRun run)
+    {
+        wallDisabled=true;
+        if(Failure.Length==0)
+        {
+            try
+            {
+                if(!wallLightUploaded)
+                {
+                    long start=Stopwatch.GetTimestamp();
