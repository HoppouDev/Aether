--- /dev/null
+++ b/Aether/UI/CachedText.cs
@@ -0,0 +1,251 @@
+using System;
+using System.Collections.Generic;
+using System.Runtime.CompilerServices;
+using Microsoft.Xna.Framework;
+using ReLogic.Graphics;
+using Terraria;
+using Terraria.Localization;
+using Terraria.UI.Chat;
+
+namespace Aether.UI;
+
+/// <summary>
+/// Text the UI draws every frame, made once instead of every frame (stack counts, slot numbers,
+/// defense, ...), so drawing it doesn't allocate.
+/// </summary>
+public static class CachedText
+{
+    private const int CachedNumbers = 10000;
+
+    private static readonly string[] Numbers = new string[CachedNumbers];
+
+    /// <summary>value.ToString(), cached for 0 to 9999.</summary>
+    public static string Number(int value)
+    {
+        if (value < 0 || value >= CachedNumbers)
+        {
+            return value.ToString();
+        }
+        return Numbers[value] ??= value.ToString();
+    }
+
+    /// <summary>value.ToString() for a long (savings), cached for 0 to 9999.</summary>
+    public static string Number(long value)
+    {
+        if (value < 0 || value >= CachedNumbers)
+        {
+            return value.ToString();
+        }
+        return Number((int)value);
+    }
+
+    private static DynamicSpriteFont _measuredFont;
+
+    private static readonly Dictionary<string, Vector2> ChatSizes = new Dictionary<string, Vector2>();
+
+    /// <summary>
+    /// ChatManager.GetStringSize(font, text, Vector2.One), which parses the text for chat tags every
+    /// call, cached per text (for labels that are measured every frame). Forgets everything when the
+    /// font changes (a language change) or after 256 texts.
+    /// </summary>
+    public static Vector2 ChatSize(DynamicSpriteFont font, string text)
+    {
+        if (font != _measuredFont || ChatSizes.Count >= 256)
+        {
+            _measuredFont = font;
+            ChatSizes.Clear();
+        }
+        if (!ChatSizes.TryGetValue(text, out var size))
+        {
+            size = ChatManager.GetStringSize(font, text, Vector2.One);
+            ChatSizes[text] = size;
+        }
+        return size;
+    }
+
+    private static readonly int[] Coins = new int[4];
+
+    /// <summary>Utils.CoinsSplit into a shared array (valid until the next call), for drawing.</summary>
+    public static int[] CoinsSplit(long count)
+    {
+        long done = 0L;
+        long unit = 1000000L;
+        for (int i = 3; i >= 0; i--)
+        {
+            Coins[i] = (int)((count - done) / unit);
+            done += Coins[i] * unit;
+            unit /= 100;
+        }
+        return Coins;
+    }
+
+    /// <summary>A whole number held in a double (e.g. Math.Round's result) as text, cached for 0 to 9999.</summary>
+    public static string Number(double value)
+    {
+        if (value >= 0.0 && value < CachedNumbers && value == Math.Floor(value))
+        {
+            return Number((int)value);
+        }
+        return value.ToString();
+    }
+
+    // Up to five pieces of text, compared by reference: the pieces are localized values, literals and
+    // cached numbers, which are the same objects from one frame to the next.
+    private struct Pieces : IEquatable<Pieces>
+    {
+        public object A;
+
+        public object B;
+
+        public object C;
+
+        public object D;
+
+        public object E;
+
+        public bool Equals(Pieces other)
+        {
+            if (A == other.A && B == other.B && C == other.C && D == other.D)
+            {
+                return E == other.E;
+            }
+            return false;
+        }
+
+        public override bool Equals(object obj)
+        {
+            if (obj is Pieces other)
+            {
+                return Equals(other);
+            }
+            return false;
+        }
+
+        public override int GetHashCode()
+        {
+            int hash = RuntimeHelpers.GetHashCode(A);
+            hash = hash * 31 + RuntimeHelpers.GetHashCode(B);
+            hash = hash * 31 + RuntimeHelpers.GetHashCode(C);
+            hash = hash * 31 + RuntimeHelpers.GetHashCode(D);
+            return hash * 31 + RuntimeHelpers.GetHashCode(E);
+        }
+    }
+
+    private const int MaxJoined = 4096;
+
+    private static readonly Dictionary<Pieces, string> Concats = new Dictionary<Pieces, string>();
+
+    private static readonly Dictionary<Pieces, string> Formats = new Dictionary<Pieces, string>();
+
+    private static GameCulture _culture;
+
+    // Formatted texts depend on the language, and old pieces are garbage after a change.
+    private static void ForgetOnLanguageChange(Dictionary<Pieces, string> cache)
+    {
+        if (Language.ActiveCulture != _culture)
+        {
+            _culture = Language.ActiveCulture;
+            Concats.Clear();
+            Formats.Clear();
+        }
+        if (cache.Count >= MaxJoined)
+        {
+            cache.Clear();
+        }
+    }
+
+    /// <summary>a + b (+ c + d + e), made once per combination of these same string objects.</summary>
+    public static string Concat(string a, string b, string c = null, string d = null, string e = null)
+    {
+        ForgetOnLanguageChange(Concats);
+        Pieces key = new Pieces
+        {
+            A = a,
+            B = b,
+            C = c,
+            D = d,
+            E = e
+        };
+        if (!Concats.TryGetValue(key, out var text))
+        {
+            text = a + b + c + d + e;
+            Concats[key] = text;
+        }
+        return text;
+    }
+
+    /// <summary>Language.GetTextValue(key, arg0), made once per key, argument (by reference) and language.</summary>
+    public static string Format(string key, string arg0)
+    {
+        ForgetOnLanguageChange(Formats);
+        Pieces pieces = new Pieces
+        {
+            A = key,
+            B = arg0
+        };
+        if (!Formats.TryGetValue(pieces, out var text))
+        {
+            text = Language.GetTextValue(key, arg0);
+            Formats[pieces] = text;
+        }
+        return text;
+    }
+
+    /// <summary>Language.GetTextValue(key, arg0, arg1), made once per key, arguments (by reference) and language.</summary>
+    public static string Format(string key, string arg0, string arg1)
+    {
+        ForgetOnLanguageChange(Formats);
+        Pieces pieces = new Pieces
+        {
+            A = key,
+            B = arg0,
+            C = arg1,
+            D = Formats
+        };
+        if (!Formats.TryGetValue(pieces, out var text))
+        {
+            text = Language.GetTextValue(key, arg0, arg1);
+            Formats[pieces] = text;
+        }
+        return text;
+    }
+
+    /// <summary>An enum value's name (value.ToString()), made once per value.</summary>
+    public static string Name<TEnum>(TEnum value) where TEnum : struct
+    {
+        return EnumNames<TEnum>.Get(value);
+    }
+
+    private static class EnumNames<TEnum> where TEnum : struct
+    {
+        private static readonly Dictionary<TEnum, string> Names = new Dictionary<TEnum, string>();
+
+        public static string Get(TEnum value)
+        {
+            if (!Names.TryGetValue(value, out var name))
+            {
+                name = value.ToString();
+                Names[value] = name;
+            }
+            return name;
+        }
+    }
+
+    /// <summary>No arguments, for params object[] methods called every frame (instead of a new empty array per call).</summary>
+    public static readonly object[] NoArgs = new object[0];
+
+    /// <summary>An empty slot list, for Utils.CoinsCount's ignoreSlots (instead of a new empty array per call).</summary>
+    public static readonly int[] NoSlots = new int[0];
+
+    private static readonly long[] FourCounts = new long[4];
+
+    /// <summary>Four counts in a shared array (valid until the next call), for Utils.CoinsCombineStacks.</summary>
+    public static long[] Counts(long a, long b, long c, long d)
+    {
+        FourCounts[0] = a;
+        FourCounts[1] = b;
+        FourCounts[2] = c;
+        FourCounts[3] = d;
+        return FourCounts;
+    }
+}
