+using System;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using ReLogic.Graphics;
+using Terraria;
+using Terraria.Audio;
+using Terraria.GameContent;
+using Terraria.UI;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// One line of a title-menu screen, drawn like DrawMenu's legacy items: outlined DeathText that grows
+/// and turns gold while hovered. Labels are static text; disabled items are drawn but not clickable.
+/// </summary>
+public class UIMenuItem : UIElement
+{
+    private const float IdleScale = 0.8f;
+
+    private readonly Func<string> _text;
+
+    private readonly Action _onClick;
+
+    private string _shownText;
+
+    private float _hoverScale = IdleScale;
+
+    /// <summary>Text size relative to a regular menu item (DrawMenu's per-item scale).</summary>
+    public float TextScale = 1f;
+
+    /// <summary>Extra scale applied only when drawing (DrawMenu shrinks some status texts without moving them).</summary>
+    public float DrawScale = 1f;
+
+    public bool IsLabel;
+
+    internal bool HideAutomationLabel;
+
+    internal override string AutomationLabel => HideAutomationLabel ? null : _shownText;
+
+    public Func<bool> IsDisabled;
+
+    public bool IsInteractive
+    {
+        get
+        {
+            if (!IsLabel && _onClick != null)
+            {
+                if (IsDisabled != null)
+                {
+                    return !IsDisabled();
+                }
+                return true;
+            }
+            return false;
+        }
+    }
+
+    public UIMenuItem(Func<string> text, Action onClick)
+    {
+        _text = text;
+        _onClick = onClick;
+    }
+
+    public override void Update(GameTime gameTime)
+    {
+        base.Update(gameTime);
+        UpdateSize();
+        if (IsMouseHovering && IsInteractive)
+        {
+            _hoverScale = Math.Min(1f, _hoverScale + 0.02f * Aether.Graphics.VisualAnimationTime.FrameScale);
+        }
+        else if (_hoverScale > IdleScale)
+        {
+            _hoverScale = Math.Max(IdleScale, _hoverScale - 0.02f * Aether.Graphics.VisualAnimationTime.FrameScale);
+        }
+    }
+
+    private void UpdateSize()
+    {
+        string text = _text() ?? "";
+        if (text == _shownText)
+        {
+            return;
+        }
+        _shownText = text;
+        Width.Set(FontAssets.DeathText.Value.MeasureString(text).X * TextScale, 0f);
+        Height.Set(50f * TextScale, 0f);
+        Recalculate();
+    }
+
+    public override void MouseOver(UIMouseEvent evt)
+    {
+        base.MouseOver(evt);
+        if (IsInteractive)
+        {
+            SoundEngine.PlaySound(12);
+        }
+    }
+
+    public override void LeftClick(UIMouseEvent evt)
+    {
+        base.LeftClick(evt);
+        if (IsInteractive)
+        {
+            MenuPreview.Act(_shownText, _onClick);
+        }
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        UpdateSize();
+        if (_shownText.Length == 0)
+        {
+            return;
+        }
+        DynamicSpriteFont font = FontAssets.DeathText.Value;
+        Vector2 origin = font.MeasureString(_shownText) * 0.5f;
+        CalculatedStyle dimensions = GetDimensions();
+        Vector2 center = new Vector2(dimensions.X + dimensions.Width * 0.5f, dimensions.Y + origin.Y * TextScale);
+        bool interactive = IsInteractive;
+        if (interactive)
+        {
+            MenuScreens.AddGamepadPoint(center);
+        }
+        // DrawMenu's colours: the menu tint brightened, faded in with the hover scale, gold when hovered.
+        byte tint = (byte)((255 + Main.tileColor.R * 2) / 3);
+        int alpha = IsLabel ? 255 : (int)(255f * (_hoverScale * 2f - 1f));
+        bool hovered = interactive && IsMouseHovering;
+        for (int i = 0; i < 5; i++)
+        {
+            Color color = Color.Black;
+            if (i == 4)
+            {
+                color = new Color((255 + tint) / 2, (255 + tint) / 2, (255 + tint) / 2);
+            }
+            int r = Math.Max(0, color.R - (255 - alpha));
+            int g = Math.Max(0, color.G - (255 - alpha));
+            int b = Math.Max(0, color.B - (255 - alpha));
+            if (hovered && i == 4)
+            {
+                float blend = alpha / 255f;
+                r = (int)(r * (1f - blend) + 255f * blend);
+                g = (int)(g * (1f - blend) + 215f * blend);
+                b = (int)(b * (1f - blend));
+            }
+            Vector2 offset = i switch
+            {
+                0 => new Vector2(-2f, 0f),
+                1 => new Vector2(2f, 0f),
+                2 => new Vector2(0f, -2f),
+                3 => new Vector2(0f, 2f),
+                _ => Vector2.Zero
+            };
+            spriteBatch.DrawString(font, _shownText, center + offset, new Color((byte)r, (byte)g, (byte)b, (byte)alpha), 0f, origin, _hoverScale * TextScale * DrawScale, SpriteEffects.None, 0f);
+        }
+    }
+}
