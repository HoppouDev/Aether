@@ -0,0 +1,28 @@
+using Terraria;
+using Terraria.Audio;
+
+namespace Aether.UI.Menu;
+
+/// <summary>A connection error (menuMode 15): the error in small print and Back.</summary>
+public class UIConnectionErrorMenu : UIMenuScreen
+{
+    public UIConnectionErrorMenu()
+    {
+        ItemsTop = 80f;
+        ItemSpacing = 400f;
+    }
+
+    protected override void BuildItems()
+    {
+        AddLabel(() => Main.statusText).DrawScale = 0.35f;
+        AddItem(() => Lang.menu[5].Value, GoBack);
+    }
+
+    public override void GoBack()
+    {
+        Netplay.Disconnect = true;
+        SoundEngine.PlaySound(11);
+        Main.menuMode = 0;
+        Main.netMode = 0;
+    }
+}
