+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using Terraria;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// <c>Main.statusText</c> on its own: menuMode 10 (loading or saving, with game tips; also mode 0
+/// while a client connection runs) and 100 (no tips).
+/// </summary>
+public class UIStatusMenu : UIMenuScreen
+{
+    private readonly bool _showTips;
+
+    public UIStatusMenu(bool showTips)
+    {
+        _showTips = showTips;
+        ItemsTop = 300f;
+    }
+
+    protected override void BuildItems()
+    {
+        AddLabel(() => Main.statusText);
+    }
+
+    public override void Update(GameTime gameTime)
+    {
+        if (_showTips)
+        {
+            Main.gameTips.Update();
+        }
+        base.Update(gameTime);
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        if (_showTips)
+        {
+            Main.gameTips.Draw();
+        }
+    }
+}
