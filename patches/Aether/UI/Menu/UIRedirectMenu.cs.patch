+using System;
+using Terraria;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// A mode that only opens a vanilla retained screen: 1 (character list) and 6 (world list). In a
+/// preview it stays put and says where it would go.
+/// </summary>
+public class UIRedirectMenu : UIMenuScreen
+{
+    private readonly Action _redirect;
+
+    private readonly string _target;
+
+    public UIRedirectMenu(Action redirect, string target)
+    {
+        _redirect = redirect;
+        _target = target;
+    }
+
+    protected override void BuildItems()
+    {
+        AddLabel(() => CachedText.Concat("Opens ", _target), 0.6f);
+    }
+
+    public override void UpdateState()
+    {
+        if (!MenuPreview.IsPreviewing)
+        {
+            _redirect();
+        }
+    }
+}
