+using Terraria;
+using Terraria.Audio;
+using Terraria.DataStructures;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// A refusal with Back: menuMode 1000000 (back to world select) and 1000001 (text and back action
+/// from <c>Main.instance.RejectionMenuInfo</c>, if set).
+/// </summary>
+public class UIRejectedMenu : UIMenuScreen
+{
+    private readonly bool _custom;
+
+    public UIRejectedMenu(bool custom)
+    {
+        _custom = custom;
+        ItemsTop = 220f;
+        ItemSpacing = 250f;
+    }
+
+    protected override void BuildItems()
+    {
+        UIMenuItem text = AddLabel(() => (_custom && Main.instance.RejectionMenuInfo != null) ? Main.instance.RejectionMenuInfo.TextToShow : Main.statusText);
+        if (!_custom)
+        {
+            text.DrawScale = 0.75f;
+        }
+        AddItem(() => Lang.menu[5].Value, GoBack);
+    }
+
+    public override void GoBack()
+    {
+        if (!_custom)
+        {
+            SoundEngine.PlaySound(11);
+            Main.menuMode = 6;
+            Main.netMode = 0;
+            return;
+        }
+        ReturnFromRejectionMenuAction exitAction = Main.instance.RejectionMenuInfo?.ExitAction;
+        if (exitAction != null)
+        {
+            exitAction();
+            return;
+        }
+        SoundEngine.PlaySound(11);
+        Main.menuMode = 0;
+        Main.netMode = 0;
+    }
+}
