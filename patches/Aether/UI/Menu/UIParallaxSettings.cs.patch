@@ -0,0 +1,45 @@
+using Terraria;
+using Terraria.Audio;
+
+namespace Aether.UI.Menu;
+
+/// <summary>Settings → Video → Parallax (menuMode 28).</summary>
+public class UIParallaxSettings : UIMenuScreen
+{
+    public UIParallaxSettings()
+    {
+        ItemsTop = 240f;
+        ItemSpacing = 60f;
+    }
+
+    protected override void BuildItems()
+    {
+        AddLabel(() => "");
+        AddLabel(() => Lang.menu[52].Value, 1f, 10f);
+        AddItem(() => Lang.menu[5].Value, GoBack, 1f, 170f);
+        UIMenuText text = new UIMenuText(() => CachedText.Concat(Lang.menu[52].Value, ": ", CachedText.Number(Main.bgScroll)));
+        text.Left.Set(-30f, 0.5f);
+        text.Top.Set(400f, 0f);
+        Append(text);
+        UIMenuSlider slider = new UIMenuSlider(() => Main.bgScroll / 100f, delegate(float value)
+        {
+            Main.bgScroll = (int)(value * 100f);
+            Main.caveParallax = 1f - Main.bgScroll / 500f;
+        }, 1);
+        slider.AutomationCaption = () => Lang.menu[52].Value;
+        slider.Left.Set(-40f - slider.Width.Pixels, 0.5f);
+        slider.Top.Set(412f - slider.Height.Pixels / 2f, 0f);
+        Append(slider);
+    }
+
+    public override void UpdateState()
+    {
+        Main.caveParallax = 1f - Main.bgScroll / 500f;
+    }
+
+    public override void GoBack()
+    {
+        Main.menuMode = 1111;
+        SoundEngine.PlaySound(11);
+    }
+}
