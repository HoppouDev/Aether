+using Microsoft.Xna.Framework;
+using Terraria;
+using Terraria.Audio;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// Settings → Cursor → cursor colour (menuMode 25) or border colour (252, with alpha and a full
+/// luminosity range): HSL bars that edit Main.selColor, copied into the setting every frame.
+/// </summary>
+public class UICursorColorMenu : UIMenuScreen
+{
+    private readonly bool _border;
+
+    private UIMenuColorBars _bars;
+
+    public UICursorColorMenu(bool border)
+    {
+        _border = border;
+        ItemsTop = 200f;
+        ItemSpacing = 10f;
+    }
+
+    protected override void BuildItems()
+    {
+        AddLabel(() => "");
+        AddLabel(() => Lang.menu[_border ? 217 : 64].Value, 1f, 10f);
+        AddItem(() => Lang.menu[5].Value, GoBack, 1f, 250f);
+        _bars = new UIMenuColorBars(_border, _border ? 0f : 0.15f);
+        _bars.Top.Set(320f, 0f);
+        _bars.Load();
+        Append(_bars);
+    }
+
+    public override void Update(GameTime gameTime)
+    {
+        base.Update(gameTime);
+        if (_border)
+        {
+            Main.MouseBorderColor = Main.selColor;
+            Main.mouseBorderColorSlider.SetHSL(Main.mouseColor);
+        }
+        else
+        {
+            Main.mouseColor = Main.selColor;
+            Main.mouseColorSlider.SetHSL(Main.mouseColor);
+        }
+    }
+
+    public override void GoBack()
+    {
+        Main.menuMode = 1125;
+        SoundEngine.PlaySound(11);
+    }
+}
