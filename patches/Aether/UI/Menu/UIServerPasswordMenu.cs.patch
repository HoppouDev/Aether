--- /dev/null
+++ b/Aether/UI/Menu/UIServerPasswordMenu.cs
@@ -0,0 +1,48 @@
+using Microsoft.Xna.Framework;
+using Terraria;
+using Terraria.GameContent.UI.States;
+using Terraria.GameInput;
+
+namespace Aether.UI.Menu;
+
+/// <summary>The server asked for a password (menuMode 31); with gamepad hints on, the virtual keyboard.</summary>
+public class UIServerPasswordMenu : UIMenuScreen
+{
+    protected override void BuildItems()
+    {
+        AddLabel(() => Lang.menu[3].Value);
+        AddLabel(() => WithCursor(Main.HidePassword ? new string('*', Netplay.ServerPassword.Length) : Netplay.ServerPassword), 1f, -20f);
+        AddItem(() => Lang.menu[4].Value, Main.OnSubmitServerPasswordFromRequest, 1f, 20f);
+        AddItem(() => Lang.menu[5].Value, GoBack);
+    }
+
+    public override void Update(GameTime gameTime)
+    {
+        // In a preview, show the keyboard version of the screen rather than leaving it.
+        if (PlayerInput.SettingsForUI.ShowGamepadHints && !MenuPreview.IsPreviewing)
+        {
+            OpenVirtualKeyboard();
+            return;
+        }
+        Netplay.ServerPassword = ReadTextInput(Netplay.ServerPassword);
+        BlinkCursor();
+        base.Update(gameTime);
+        if (Main.menuMode == 31 && Main.inputTextEnter)
+        {
+            Act("Enter", Main.OnSubmitServerPasswordFromRequest);
+        }
+    }
+
+    private static void OpenVirtualKeyboard()
+    {
+        UIVirtualKeyboard uIVirtualKeyboard = new UIVirtualKeyboard(Lang.menu[3].Value, Netplay.ServerPassword, Main.OnSubmitServerPasswordFromRequest, Main.CanceledGivingServerPassword, 0, allowEmpty: true);
+        uIVirtualKeyboard.HideContents = Main.HidePassword;
+        Main.MenuUI.SetState(uIVirtualKeyboard);
+        Main.menuMode = 888;
+    }
+
+    public override void GoBack()
+    {
+        Main.CanceledGivingServerPassword();
+    }
+}
