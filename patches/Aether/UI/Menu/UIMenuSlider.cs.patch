+using System;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using Terraria;
+using Terraria.Audio;
+using Terraria.GameContent;
+using Terraria.UI;
+using Terraria.UI.Gamepad;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// A 0..1 value bar like the legacy sliders (drawn by IngameOptions.DrawValueBar, optionally scaled
+/// and with a colour ramp): press on it and drag. <c>gamepadFeature</c> is the
+/// UILinksInitializer.HandleOptionsSpecials case that adjusts the same value with the gamepad while
+/// the bar is focused.
+/// </summary>
+public class UIMenuSlider : UIElement
+{
+    private readonly Func<float> _getValue;
+
+    private readonly Action<float> _setValue;
+
+    private readonly int _gamepadFeature;
+
+    private readonly float _barScale;
+
+    private readonly Utils.ColorLerpMethod _colorMethod;
+
+    private bool _dragging;
+
+    /// <summary>Runs before drawing (e.g. to set DelegateMethods.v3_1 for an HSL colour ramp).</summary>
+    public Action BeforeDraw;
+
+    /// <summary>Runs every frame the bar is hovered or dragged, after it claims the gamepad feature.</summary>
+    public Action WhileFocused;
+
+    /// <summary>Whether something else (e.g. the row the bar sits in) counts as focusing it too.</summary>
+    public Func<bool> AlsoFocused;
+
+    public bool IsDragging => _dragging;
+
+    public UIMenuSlider(Func<float> getValue, Action<float> setValue, int gamepadFeature, float barScale = 1f, Utils.ColorLerpMethod colorMethod = null)
+    {
+        _getValue = getValue;
+        _setValue = setValue;
+        _gamepadFeature = gamepadFeature;
+        _barScale = barScale;
+        _colorMethod = colorMethod;
+        Width.Set(TextureAssets.ColorBar.Width() * barScale, 0f);
+        Height.Set(TextureAssets.ColorBar.Height() * barScale, 0f);
+    }
+
+    public override void LeftMouseDown(UIMouseEvent evt)
+    {
+        base.LeftMouseDown(evt);
+        _dragging = true;
+    }
+
+    public override void MouseOver(UIMouseEvent evt)
+    {
+        base.MouseOver(evt);
+        SoundEngine.PlaySound(12);
+    }
+
+    public override void Update(GameTime gameTime)
+    {
+        base.Update(gameTime);
+        if (!Main.mouseLeft)
+        {
+            _dragging = false;
+        }
+        if (_dragging)
+        {
+            // The bar's track is inset 5px (scaled) on each side.
+            CalculatedStyle dimensions = GetDimensions();
+            float inset = 5f * _barScale;
+            _setValue(MathHelper.Clamp((Main.MouseScreen.X - dimensions.X - inset) / (dimensions.Width - inset * 2f), 0f, 1f));
+        }
+        if (_dragging || IsMouseHovering || (AlsoFocused != null && AlsoFocused()))
+        {
+            UILinkPointNavigator.Shortcuts.OPTIONS_BUTTON_SPECIALFEATURE = _gamepadFeature;
+            WhileFocused?.Invoke();
+        }
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        CalculatedStyle dimensions = GetDimensions();
+        Vector2 center = dimensions.Center();
+        MenuScreens.AddGamepadPoint(center);
+        BeforeDraw?.Invoke();
+        // DrawValueBar takes the bar's right edge and vertical centre.
+        IngameOptions.valuePosition = new Vector2(dimensions.X + dimensions.Width, center.Y);
+        IngameOptions.DrawValueBar(spriteBatch, _barScale, _getValue(), _dragging ? 1 : 0, _colorMethod);
+    }
+}
