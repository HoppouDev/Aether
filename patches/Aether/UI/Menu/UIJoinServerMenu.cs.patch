+++ b/Aether/UI/Menu/UIJoinServerMenu.cs
@@ -0,0 +1,104 @@
+using Microsoft.Xna.Framework;
+using Terraria;
+using Terraria.Audio;
+using Terraria.GameContent.UI.States;
+using Terraria.GameInput;
+using Terraria.Localization;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// "Enter server IP address" (menuMode 13), with the recent servers below it. With gamepad hints on,
+/// the address opens the virtual keyboard instead of being typed in place.
+/// </summary>
+public class UIJoinServerMenu : UIMenuScreen
+{
+    private bool _builtForGamepad;
+
+    public UIJoinServerMenu()
+    {
+        ItemsTop = 180f;
+        ItemSpacing = 30f;
+    }
+
+    protected override void BuildItems()
+    {
+        _builtForGamepad = PlayerInput.SettingsForUI.ShowGamepadHints;
+        if (_builtForGamepad)
+        {
+            AddItem(Lang.menu[89].Value.Replace(":", ""), delegate
+            {
+                Main.MenuUI.SetState(new UIVirtualKeyboard(Lang.menu[89].Value, Main.getIP, Main.OnSubmitServerIP, Main.CreateGoToMenuEvent(13), 0, allowEmpty: true));
+                Main.menuMode = 888;
+            }, 0.6f, 40f);
+        }
+        else
+        {
+            AddLabel(() => Lang.menu[89].Value);
+            AddLabel(() => WithCursor(Main.getIP), 1f, 19f);
+        }
+        for (int i = 0; i < 7; i++)
+        {
+            int recent = i;
+            if (string.IsNullOrEmpty(Main.recentWorld[recent]))
+            {
+                AddLabel(() => "", 0.6f, 40f);
+                continue;
+            }
+            AddItem(Main.recentWorld[recent] + " (" + Main.recentIP[recent] + ":" + Main.recentPort[recent] + ")", delegate
+            {
+                Connect(recent);
+            }, 0.6f, 40f);
+        }
+        if (!_builtForGamepad)
+        {
+            UIMenuItem accept = AddItem(Lang.menu[4].Value, delegate
+            {
+                Main.OnSubmitServerIP(Main.getIP);
+            }, 1f, 44f);
+            accept.IsDisabled = () => Main.getIP == "";
+        }
+        AddItem(Lang.menu[5].Value, GoBack, 1f, 64f);
+    }
+
+    private static void Connect(int recent)
+    {
+        Main.autoPass = false;
+        Netplay.ListenPort = Main.recentPort[recent];
+        Main.getIP = Main.recentIP[recent];
+        Netplay.SetRemoteIPAsync(Main.getIP, Main.StartClientGameplay);
+        Main.menuMode = 14;
+        Main.statusText = Language.GetTextValue("Net.ConnectingTo", Main.getIP);
+    }
+
+    public override void Update(GameTime gameTime)
+    {
+        if (PlayerInput.SettingsForUI.ShowGamepadHints != _builtForGamepad)
+        {
+            Rebuild();
+        }
+        if (!_builtForGamepad)
+        {
+            Main.getIP = ReadTextInput(Main.getIP);
+            if (Main.getIP.StartsWith(" "))
+            {
+                Main.getIP = "";
+            }
+            BlinkCursor();
+        }
+        base.Update(gameTime);
+        if (!_builtForGamepad && Main.menuMode == 13 && Main.inputTextEnter)
+        {
+            Act("Enter", delegate
+            {
+                Main.OnSubmitServerIP(Main.getIP);
+            });
+        }
+    }
+
+    public override void GoBack()
+    {
+        SoundEngine.PlaySound(11);
+        Main.menuMode = 1;
+    }
+}
