--- /dev/null
+++ b/Aether/UI/Menu/MenuScreens.cs
@@ -0,0 +1,177 @@
+using System;
+using System.Collections.Generic;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using Terraria;
+using Terraria.UI;
+using Terraria.UI.Gamepad;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// Retained-mode replacements for the title menu's legacy screens, one <see cref="UIMenuScreen" /> per
+/// <c>Main.menuMode</c>. <c>Main.DrawMenu</c> calls <see cref="Draw" /> before its legacy chain of
+/// <c>menuMode</c> branches: when a screen here owns the current mode it is updated and drawn and the
+/// legacy branch is skipped. <c>menuMode</c> keeps its vanilla meaning, so legacy screens, vanilla
+/// <c>MenuUI</c> screens (mode 888) and every other check of <c>menuMode</c> keep working, and screens
+/// can be migrated one at a time.
+/// </summary>
+public static class MenuScreens
+{
+    private static readonly Dictionary<int, Func<UIMenuScreen>> Factories = new Dictionary<int, Func<UIMenuScreen>>
+    {
+        [0] = () => new UIMainMenu(),
+        [11] = () => new UISettingsMenu(),
+        [12] = () => new UIMultiplayerMenu(),
+        [13] = () => new UIJoinServerMenu(),
+        [131] = () => new UIServerPortMenu(),
+        [10] = () => new UIStatusMenu(showTips: true),
+        [100] = () => new UIStatusMenu(showTips: false),
+        [14] = () => new UIConnectingMenu(),
+        [15] = () => new UIConnectionErrorMenu(),
+        [882] = () => new UISteamJoinMenu(),
+        [200] = () => new UIWorldLoadFailedMenu(hasBackup: true),
+        [201] = () => new UIWorldLoadFailedMenu(hasBackup: false),
+        [1000000] = () => new UIRejectedMenu(custom: false),
+        [1000001] = () => new UIRejectedMenu(custom: true),
+        [31] = () => new UIServerPasswordMenu(hosting: false),
+        [30] = () => new UIServerPasswordMenu(hosting: true),
+        [9] = () => new UIDeleteWorldMenu(),
+        [1] = () => new UIRedirectMenu(Main.OpenCharacterSelectUI, "the character list (UICharacterSelect)"),
+        [6] = () => new UIRedirectMenu(Main.OpenWorldSelectUI, "the world list (UIWorldSelect)"),
+        [5] = () => new UIDeletePlayerMenu(),
+        [40] = () => new UIDiscardCharacterMenu(),
+        [3000] = () => new UICreditsMenu(),
+        [889] = () => new UIHostSettingsMenu(),
+        [MenuPreview.GalleryMode] = () => new UIScreenGallery(),
+        [112] = () => new UIGeneralSettings(),
+        [1112] = () => new UIInterfaceSettings(),
+        [1111] = () => new UIVideoSettings(),
+        [2008] = () => new UIEffectsSettings(),
+        [111] = () => new UIResolutionSettings(),
+        [28] = () => new UIParallaxSettings(),
+        [26] = () => new UIVolumeSettings(),
+        [1125] = () => new UICursorSettings(),
+        [25] = () => new UICursorColorMenu(border: false),
+        [252] = () => new UICursorColorMenu(border: true),
+        [1127] = () => new UIControlsSettings(),
+        [1212] = () => new UILanguageMenu(firstRun: true),
+        [1213] = () => new UILanguageMenu(firstRun: false)
+    };
+
+    private static readonly Dictionary<int, UIMenuScreen> Screens = new Dictionary<int, UIMenuScreen>();
+
+    private static UserInterface _ui;
+
+    public static bool Owns(int menuMode)
+    {
+        return Factories.ContainsKey(menuMode);
+    }
+
+    public static IEnumerable<int> Modes => Factories.Keys;
+
+    // UILinksInitializer gives the title menu's gamepad page link points 2000 to 2019 only.
+    private const int GamepadPoints = 20;
+
+    /// <summary>Makes a point reachable with the gamepad (GamepadMainMenuHandler links them in draw order).</summary>
+    public static void AddGamepadPoint(Vector2 position)
+    {
+        // In game, elements shared with the title menu (sliders) link their own points instead.
+        if (Main.gameMenu && GamepadMainMenuHandler.MenuItemPositions.Count < GamepadPoints)
+        {
+            GamepadMainMenuHandler.MenuItemPositions.Add(position);
+        }
+    }
+
+    /// <summary>The screen class shown for menuMode (for the gallery and preview overlay).</summary>
+    public static string Describe(int menuMode)
+    {
+        return GetScreen(menuMode)?.GetType().Name ?? "legacy";
+    }
+
+    /// <summary>Updates and draws the screen for the current <c>menuMode</c>; false if it's still legacy.</summary>
+    public static bool Draw(SpriteBatch spriteBatch, GameTime gameTime)
+    {
+        MenuPreview.Update();
+        int mode = Main.menuMode;
+        UIMenuScreen screen = GetScreen(ShownMode(mode));
+        if (screen == null || (MenuPreview.ShowLegacy && MenuPreview.IsPreviewing))
+        {
+            _ui?.SetState(null);
+            MenuPreview.DrawOverlay(spriteBatch);
+            return false;
+        }
+        // Vanilla code opens its own screens with UserInterface.ActiveInstance (meaning Main.MenuUI),
+        // and the UserInterface constructor and Draw both take that over, so hand it back afterwards.
+        UserInterface previous = UserInterface.ActiveInstance;
+        if (_ui == null)
+        {
+            _ui = new UserInterface();
+        }
+        // Use() recalculates the layout whenever it switches instances, i.e. every frame here, which
+        // picks up resolution and text changes.
+        _ui.Use();
+        _ui.SetState(screen);
+        bool backPressed = UILinkPointNavigator.Shortcuts.BackButtonInUse && !UILinkPointNavigator.Shortcuts.BackButtonLock;
+        screen.UpdateState();
+        if (Main.menuMode == mode)
+        {
+            _ui.Update(gameTime);
+        }
+        if (backPressed && Main.menuMode == mode)
+        {
+            UILinkPointNavigator.Shortcuts.BackButtonLock = true;
+            if (MenuPreview.IsPreviewing)
+            {
+                MenuPreview.ReturnToGallery();
+            }
+            else
+            {
+                screen.GoBack();
+            }
+        }
+        if (Main.menuMode == mode)
+        {
+            _ui.Draw(spriteBatch, gameTime);
+            MenuPreview.DrawOverlay(spriteBatch);
+        }
+        previous.Use();
+        return true;
+    }
+
+    /// <summary>
+    /// The mode whose screen DrawMenu actually shows: its chain checks a few states before
+    /// <c>menuMode</c> itself, so e.g. any mode shows the connection status while <c>netMode</c> is 1.
+    /// </summary>
+    public static int ShownMode(int menuMode)
+    {
+        if (menuMode == 1212 || menuMode == 1213 || menuMode == 31)
+        {
+            return menuMode;
+        }
+        if (Main.netMode == 1 && menuMode != 888)
+        {
+            return 14;
+        }
+        if (menuMode == 0 && Netplay.ClientLoopThreadRunning)
+        {
+            return 10;
+        }
+        return menuMode;
+    }
+
+    private static UIMenuScreen GetScreen(int mode)
+    {
+        if (Screens.TryGetValue(mode, out var screen))
+        {
+            return screen;
+        }
+        if (!Factories.TryGetValue(mode, out var factory))
+        {
+            return null;
+        }
+        screen = factory();
+        Screens[mode] = screen;
+        return screen;
+    }
+}
