+using Terraria;
+using Terraria.Audio;
+
+namespace Aether.UI.Menu;
+
+/// <summary>The credits (menuMode 3000): the roll itself is a sky effect; this is its Back button.</summary>
+public class UICreditsMenu : UIMenuScreen
+{
+    public UICreditsMenu()
+    {
+        ItemsTop = 500f;
+    }
+
+    protected override void BuildItems()
+    {
+        AddItem(() => Lang.menu[5].Value, GoBack, 0.9f);
+    }
+
+    public override void GoBack()
+    {
+        SoundEngine.PlaySound(11);
+        Main.menuMode = 0;
+    }
+}
