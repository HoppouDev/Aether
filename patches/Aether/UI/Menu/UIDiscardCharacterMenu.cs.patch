+using Terraria;
+using Terraria.Audio;
+using Terraria.GameContent.UI.States;
+using Terraria.Localization;
+
+namespace Aether.UI.Menu;
+
+/// <summary>
+/// Backing out of character creation with changes (menuMode 40): discard them and go to the
+/// character list, or return to the creation screen as it was.
+/// </summary>
+public class UIDiscardCharacterMenu : UIMenuScreen
+{
+    protected override void BuildItems()
+    {
+        AddLabel(delegate
+        {
+            string name = Main.PendingPlayer?.name;
+            return string.IsNullOrEmpty(name) ? Language.GetTextValue("UI.PlayerCreateDiscardWarningNoName") : CachedText.Format("UI.PlayerCreateDiscardWarningWithName", name);
+        });
+        AddItem(() => Language.GetTextValue("UI.PlayerCreateDiscardWarningYes"), delegate
+        {
+            UICharacterCreation.BackupConfirmationState = null;
+            SoundEngine.PlaySound(10);
+            Main.OpenCharacterSelectUI();
+        });
+        AddItem(() => Language.GetTextValue("UI.PlayerCreateDiscardWarningNo"), GoBack);
+    }
+
+    public override void GoBack()
+    {
+        SoundEngine.PlaySound(11);
+        Main.menuMode = 888;
+        Main.MenuUI.SetState(UICharacterCreation.BackupConfirmationState);
+    }
+}
