+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using ReLogic.Graphics;
+using Terraria;
+using Terraria.GameContent;
+using Terraria.Localization;
+using Terraria.GameInput;
+using Terraria.UI;
+
+namespace Aether.UI.Game;
+
+/// <summary>
+/// The hotbar shown while the inventory is closed (Main.GUIHotbarDrawInner): the held item's name and
+/// ten slots that grow when selected; hovering one names it, holding the mouse on it selects it. Plus
+/// the held item's own slot after them when it isn't on the hotbar.
+/// </summary>
+public class UIHotbar : UIGameScreen
+{
+    public static readonly UIHotbar Instance = new UIHotbar();
+
+    private readonly UIHotbarSlot[] _slots = new UIHotbarSlot[10];
+
+    private int _heldSlotX;
+
+    /// <summary>Called by Main.GUIHotbarDrawInner after its visibility check; false: draw the legacy hotbar.</summary>
+    public static bool Draw()
+    {
+        InGamePreview.Update();
+        if (!UIInventorySlots.Enabled)
+        {
+            return false;
+        }
+        GameScreens.Draw(Instance, Main.spriteBatch);
+        return true;
+    }
+
+    public override void OnInitialize()
+    {
+        for (int i = 0; i < 10; i++)
+        {
+            _slots[i] = new UIHotbarSlot(i);
+            Append(_slots[i]);
+        }
+    }
+
+    public override void UpdateState()
+    {
+        Player player = Main.LocalPlayer;
+        int x = 20;
+        for (int i = 0; i < 10; i++)
+        {
+            if (i == player.selectedItem && !player.selectedItemState.HasActiveOverride)
+            {
+                if (Main.hotbarScale[i] < 1f)
+                {
+                    Main.hotbarScale[i] = System.Math.Min(1f, Main.hotbarScale[i] + 0.05f * Aether.Graphics.VisualAnimationTime.FrameScale);
+                }
+            }
+            else if ((double)Main.hotbarScale[i] > 0.75)
+            {
+                Main.hotbarScale[i] = System.Math.Max(0.75f, Main.hotbarScale[i] - 0.05f * Aether.Graphics.VisualAnimationTime.FrameScale);
+            }
+            float scale = Main.hotbarScale[i];
+            UIHotbarSlot slot = _slots[i];
+            slot.Left.Set(x, 0f);
+            slot.Top.Set((int)(20f + 22f * (1f - scale)), 0f);
+            slot.Width.Set((float)TextureAssets.InventoryBack.Width() * scale, 0f);
+            slot.Height.Set((float)TextureAssets.InventoryBack.Height() * scale, 0f);
+            x += (int)((float)TextureAssets.InventoryBack.Width() * scale) + 4;
+        }
+        _heldSlotX = x;
+        Recalculate();
+    }
+
+    // The selected item's name with its prefix, which Item.AffixName builds anew each call.
+    private string _name;
+
+    private int _nameType;
+
+    private int _namePrefix;
+
+    private GameCulture _nameCulture;
+
+    private string SelectedName(Item item)
+    {
+        if (item.prefix <= 0)
+        {
+            return item.AffixName();
+        }
+        if (_name == null || item.type != _nameType || item.prefix != _namePrefix || Language.ActiveCulture != _nameCulture)
+        {
+            _nameType = item.type;
+            _namePrefix = item.prefix;
+            _nameCulture = Language.ActiveCulture;
+            _name = item.AffixName();
+        }
+        return _name;
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        Player player = Main.LocalPlayer;
+        Item selected = player.inventory[player.selectedItem];
+        string text = (!string.IsNullOrEmpty(selected.Name)) ? SelectedName(selected) : Lang.inter[37].Value;
+        Vector2 half = FontAssets.MouseText.Value.MeasureString(text) / 2f;
+        byte c = Main.mouseTextColor;
+        spriteBatch.DrawString(FontAssets.MouseText.Value, text, new Vector2(236f - half.X, 0f), new Color(c, c, c, c), 0f, default(Vector2), 1f, SpriteEffects.None, 0f);
+    }
+
+    protected override void DrawChildren(SpriteBatch spriteBatch)
+    {
+        base.DrawChildren(spriteBatch);
+        Player player = Main.LocalPlayer;
+        if ((player.selectedItemState.HasActiveOverride || player.selectedItem >= 10) && player.selectedItem != 58 && !player.HeldItem.IsAir)
+        {
+            float saved = Main.inventoryScale;
+            Main.inventoryScale = 1f;
+            ItemSlot.Draw(spriteBatch, player.inventory, 36, player.selectedItem, new Vector2(_heldSlotX, 20f), new Color(255, 255, 255, 225));
+            Main.inventoryScale = saved;
+        }
+    }
+}
+
+/// <summary>One hotbar slot (context 13), sized by Main.hotbarScale.</summary>
+public class UIHotbarSlot : UIElement
+{
+    private readonly int _slot;
+
+    public UIHotbarSlot(int slot)
+    {
+        _slot = slot;
+    }
+
+    // Like the legacy hit test: edges included, and not while the hotbar is locked or the held item busy.
+    public override bool ContainsPoint(Vector2 point)
+    {
+        Player player = Main.LocalPlayer;
+        if (player.hbLocked || PlayerInput.IgnoreMouseInterface || player.controlTorch || player.channel)
+        {
+            return false;
+        }
+        CalculatedStyle dimensions = GetDimensions();
+        if (point.X >= dimensions.X && point.X <= dimensions.X + dimensions.Width && point.Y >= dimensions.Y)
+        {
+            return point.Y <= dimensions.Y + dimensions.Height;
+        }
+        return false;
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        Player player = Main.LocalPlayer;
+        if (IsMouseHovering && ContainsPoint(Main.MouseScreen))
+        {
+            player.mouseInterface = true;
+            player.cursorItemIconEnabled = false;
+            if (Main.mouseLeft && !player.hbLocked && !Main.blockMouse)
+            {
+                player.changeItem = _slot;
+            }
+            Item item = player.inventory[_slot];
+            Main.hoverItemName = item.AffixName();
+            if (item.stack > 1)
+            {
+                Main.hoverItemName = Main.hoverItemName + " (" + item.stack + ")";
+            }
+            Main.rare = item.expert ? (-12) : item.rare;
+        }
+        float scale = Main.hotbarScale[_slot];
+        float saved = Main.inventoryScale;
+        Main.inventoryScale = scale;
+        CalculatedStyle dimensions = GetDimensions();
+        ItemSlot.Draw(spriteBatch, player.inventory, 13, _slot, new Vector2(dimensions.X, dimensions.Y), new Color(255, 255, 255, (int)(75f + 150f * scale)));
+        Main.inventoryScale = saved;
+    }
+}
