+using Terraria.UI;
+
+namespace Aether.UI.Game;
+
+/// <summary>A retained-mode replacement for a piece of the in-game UI (see <see cref="GameScreens" />).</summary>
+public abstract class UIGameScreen : UIState
+{
+    /// <summary>
+    /// The legacy code's per-frame work that isn't drawing or input, run before input is handled (as
+    /// the legacy code does it before acting on clicks). Not in Update: UserInterface handles clicks
+    /// before updating the state, so a reset there would undo them.
+    /// </summary>
+    public virtual void UpdateState()
+    {
+    }
+}
