+/// <summary>A line of plain text (SpriteBatch.DrawString), optionally right-aligned on its position.</summary>
+public class UIResourceText : UIElement
+{
+    public string Text;
+
+    public Vector2 Position;
+
+    public bool RightAligned;
+
+    public UIResourceText()
+    {
+        IgnoresMouseInteraction = true;
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        if (Text == null)
+        {
+            return;
+        }
+        DynamicSpriteFont font = FontAssets.MouseText.Value;
+        Color color = new Color(Main.mouseTextColor, Main.mouseTextColor, Main.mouseTextColor, Main.mouseTextColor);
+        Vector2 origin = RightAligned ? new Vector2(font.MeasureString(Text).X, 0f) : default(Vector2);
+        spriteBatch.DrawString(font, Text, Position, color, 0f, origin, 1f, SpriteEffects.None, 0f);
+    }
+}
