+
+    /// <summary>"Life" and "x/y", centred on center the way the legacy sets centre "Life max/max".</summary>
+    private void LayOutLifeText(Player player, Vector2 center)
+    {
+        string text = Lang.inter[0].Value + " " + player.statLifeMax2 + "/" + player.statLifeMax2;
+        Vector2 size = FontAssets.MouseText.Value.MeasureString(text);
+        SetText(0, Lang.inter[0].Value, center + new Vector2((0f - size.X) * 0.5f, 0f));
+        SetText(1, player.statLife + "/" + player.statLifeMax2, center + new Vector2(size.X * 0.5f, 0f), rightAligned: true);
+    }
+
+    /// <summary>The same as ResourceDrawSettings.Draw, laying out pieces instead of drawing them.</summary>
+    private static void Lay(List<ResourcePiece> pieces, Vector2 topLeftAnchor, int count, int indexOffset, ResourceDrawSettings.TextureGetter getTexture, Vector2 offsetPerDraw, Vector2 offsetPerDrawByTexturePercentile, Vector2 offsetSpriteAnchorByTexturePercentile)
+    {
+        for (int i = 0; i < count; i++)
+        {
+            getTexture(i + indexOffset, indexOffset, indexOffset + count - 1, out var texture, out var drawOffset, out var drawScale, out var sourceRect);
+            Rectangle source = sourceRect ?? texture.Frame();
+            Vector2 position = topLeftAnchor + drawOffset;
+            Vector2 origin = source.Size() * offsetSpriteAnchorByTexturePercentile;
+            Rectangle hit = source;
+            hit.X += (int)(position.X - origin.X);
+            hit.Y += (int)(position.Y - origin.Y);
+            pieces.Add(new ResourcePiece
+            {
+                Texture = texture.Value,
+                Position = position,
+                Source = source,
+                Color = Color.White,
+                Origin = origin,
+                Scale = drawScale,
+                Hit = hit
+            });
+            topLeftAnchor += offsetPerDraw + source.Size() * offsetPerDrawByTexturePercentile;
+        }
+    }
+
+    // Classic (ClassicPlayerResourcesDisplaySet): a heart per 20 life (more per heart past 400 max
+    // life, golden for life fruit), two rows of ten, and a column of stars; the one being filled pulses.
+
+    private void LayOutClassic(Player player)
+    {
+        int anchorX = Main.screenWidth - 800;
+        _classicAnchorX = anchorX;
+        _classicLifePerHeart = 20f;
+        _life.Area = _classicLifeArea;
+        _mana.Area = _classicManaArea;
+        if (player.ghost)
+        {
+            return;
+        }
+        int hearts = player.statLifeMax / 20;
+        int fruit = (player.statLifeMax - 400) / 5;
+        if (fruit < 0)
+        {
+            fruit = 0;
+        }
+        if (fruit > 0)
+        {
+            hearts = player.statLifeMax / (20 + fruit / 4);
+            _classicLifePerHeart = (float)player.statLifeMax / 20f;
+        }
+        _classicLifePerHeart += (player.statLifeMax2 - player.statLifeMax) / hearts;
+        float lifePerHeart = _classicLifePerHeart;
+        int row = (int)((float)player.statLifeMax2 / lifePerHeart);
+        if (row >= 10)
+        {
+            row = 10;
+        }
+        LayOutLifeText(player, new Vector2(500 + 13 * row + anchorX, 6f));
+        Texture2D heart = TextureAssets.Heart.Value;
+        int width = TextureAssets.Heart.Width();
+        int height = TextureAssets.Heart.Height();
+        for (int i = 1; i < (int)((float)player.statLifeMax2 / lifePerHeart) + 1; i++)
+        {
+            ClassicFill(player.statLife, i, lifePerHeart, out int shade, out float scale);
+            int x = 0;
+            int y = 0;
+            if (i > 10)
+            {
+                x -= 260;
+                y += 26;
+            }
+            Texture2D texture = heart;
+            if (fruit > 0)
+            {
+                fruit--;
+                texture = TextureAssets.Heart2.Value;
+            }
+            _life.Pieces.Add(new ResourcePiece
+            {
+                Texture = texture,
+                Position = new Vector2(500 + 26 * (i - 1) + x + anchorX + width / 2, 32f + ((float)height - (float)height * scale) / 2f + (float)y + (float)(height / 2)),
+                Source = new Rectangle(0, 0, width, height),
+                Color = new Color(shade, shade, shade, (int)((double)shade * 0.9)),
+                Origin = new Vector2(width / 2, height / 2),
+                Scale = scale
+            });
+        }
+        if (player.statManaMax2 <= 0)
+        {
+            return;
+        }
+        Vector2 size = FontAssets.MouseText.Value.MeasureString(Lang.inter[2].Value);
+        int textWidth = 50;
+        if (size.X >= 45f)
+        {
+            textWidth = (int)size.X + 5;
+        }
+        SetText(2, Lang.inter[2].Value, new Vector2(800 - textWidth + anchorX, 6f));
+        int starWidth = TextureAssets.Mana.Width();
+        int starHeight = TextureAssets.Mana.Height();
+        for (int i = 1; i < player.statManaMax2 / 20 + 1; i++)
+        {
+            ClassicFill(player.statMana, i, 20f, out int shade, out float scale);
+            _mana.Pieces.Add(new ResourcePiece
+            {
+                Texture = TextureAssets.Mana.Value,
+                Position = new Vector2(775 + anchorX, (float)(30 + starHeight / 2) + ((float)starHeight - (float)starHeight * scale) / 2f + (float)(28 * (i - 1))),
+                Source = new Rectangle(0, 0, starWidth, starHeight),
+                Color = new Color(shade, shade, shade, (int)((double)shade * 0.9)),
+                Origin = new Vector2(starWidth / 2, starHeight / 2),
+                Scale = scale
+            });
+        }
+    }
+
+    /// <summary>The classic style's life hover area: the heart rows.</summary>
+    private bool ClassicLifeArea(Vector2 point)
+    {
+        Player localPlayer = Main.LocalPlayer;
+        int width = 26 * localPlayer.statLifeMax2 / (int)_classicLifePerHeart;
+        int extraHeight = 0;
+        if (localPlayer.statLifeMax2 > 200)
+        {
+            width = 260;
+            extraHeight += 26;
+        }
+        return point.X > (float)(500 + _classicAnchorX) && point.X < (float)(500 + width + _classicAnchorX) && point.Y > 32f && point.Y < (float)(32 + TextureAssets.Heart.Height() + extraHeight);
+    }
+
+    /// <summary>The classic style's mana hover area: the star column.</summary>
+    private bool ClassicManaArea(Vector2 point)
+    {
+        int height = 28 * Main.LocalPlayer.statManaMax2 / 20;
+        return point.X > (float)(762 + _classicAnchorX) && point.X < (float)(786 + _classicAnchorX) && point.Y > 30f && point.Y < (float)(30 + height);
+    }
+
+    /// <summary>How full the n-th (from 1) classic heart or star is drawn: its shade and scale (the one being filled pulses with the cursor).</summary>
+    private static void ClassicFill(int value, int n, float perIcon, out int shade, out float scale)
+    {
+        shade = 255;
+        scale = 1f;
+        bool pulse = false;
+        if ((float)value >= (float)n * perIcon)
+        {
+            if ((float)value == (float)n * perIcon)
+            {
+                pulse = true;
+            }
+        }
+        else
+        {
+            float fill = ((float)value - (float)(n - 1) * perIcon) / perIcon;
+            shade = (int)(30f + 225f * fill);
+            if (shade < 30)
+            {
+                shade = 30;
+            }
+            scale = fill / 4f + 0.75f;
+            if ((double)scale < 0.75)
+            {
+                scale = 0.75f;
+            }
+            if (fill > 0f)
+            {
+                pulse = true;
+            }
+        }
+        if (pulse)
+        {
+            scale += Main.cursorScale - 1f;
+        }
+    }
+
+    // Framed hearts and stars (FancyClassicPlayerResourcesDisplaySet): a frame of panels (two rows of
+    // ten hearts, a column of stars) with each heart or star filled to scale.
+
+    private void LayOutFancy(Player player, bool withText)
+    {
+        _stats = new PlayerStatsSnapshot(player);
+        float lifePerHeart = _stats.LifePerSegment;
+        int row1 = Utils.Clamp((int)((float)_stats.LifeMax / lifePerHeart), 0, 10);
+        int row2 = Utils.Clamp((int)((float)(_stats.LifeMax - 200) / lifePerHeart), 0, 10);
+        _lastHeartFilling = (int)((float)_stats.Life / lifePerHeart);
+        _lastHeartPanel = row1 + row2 - 1;
+        int stars = (int)((float)_stats.ManaMax / _stats.ManaPerSegment);
+        _lastStarFilling = (int)((float)_stats.Mana / _stats.ManaPerSegment);
+        Vector2 anchor = new Vector2(Main.screenWidth - 300 + 4, 15f);
+        if (withText)
+        {
+            anchor.Y += 6f;
+            LayOutLifeText(player, anchor + new Vector2(-4f, 3f) + new Vector2(130f, -24f));
+        }
+        Lay(_life.Pieces, anchor, row1, 0, _heartPanel, Vector2.Zero, Vector2.UnitX, Vector2.Zero);
+        Lay(_life.Pieces, anchor + new Vector2(0f, 28f), row2, 10, _heartPanel, Vector2.Zero, Vector2.UnitX, Vector2.Zero);
+        Lay(_life.Pieces, anchor + new Vector2(15f, 15f), row1, 0, _heartFilling, Vector2.UnitX * 2f, Vector2.UnitX, new Vector2(0.5f, 0.5f));
+        Lay(_life.Pieces, anchor + new Vector2(15f, 15f) + new Vector2(0f, 28f), row2, 10, _heartFilling, Vector2.UnitX * 2f, Vector2.UnitX, new Vector2(0.5f, 0.5f));
+        Vector2 manaAnchor = new Vector2(Main.screenWidth - 40, 22f);
+        Lay(_mana.Pieces, manaAnchor, stars, 0, _starPanel, Vector2.Zero, Vector2.UnitY, Vector2.Zero);
+        Lay(_mana.Pieces, manaAnchor + new Vector2(15f, 16f), stars, 0, _starFilling, Vector2.UnitY * -2f, Vector2.UnitY, new Vector2(0.5f, 0.5f));
+    }
+
+    private void HeartPanel(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        source = null;
+        offset = Vector2.Zero;
+        sprite = _heartLeft;
+        scale = 1f;
+        if (index == last && index == first)
+        {
+            sprite = _heartSingleFancy;
+            offset = new Vector2(-4f, -4f);
+        }
+        else if (index == last && last == _lastHeartPanel)
+        {
+            sprite = _heartRightFancy;
+            offset = new Vector2(-8f, -4f);
+        }
+        else if (index == last)
+        {
+            sprite = _heartRight;
+        }
+        else if (index != first)
+        {
+            sprite = _heartMiddle;
+        }
+    }
+
+    private void HeartFilling(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        source = null;
+        offset = Vector2.Zero;
+        sprite = index < _stats.LifeFruitCount ? _heartFillHoney : _heartFill;
+        float lifePerHeart = _stats.LifePerSegment;
+        float fill = (scale = Utils.GetLerpValue(lifePerHeart * (float)index, lifePerHeart * (float)(index + 1), _stats.Life, clamped: true));
+        if (index == _lastHeartFilling && fill > 0f)
+        {
+            scale += Main.cursorScale - 1f;
+        }
+    }
+
+    private void StarPanel(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        source = null;
+        offset = Vector2.Zero;
+        sprite = _starTop;
+        scale = 1f;
+        if (index == last && index == first)
+        {
+            sprite = _starSingle;
+        }
+        else if (index == last)
+        {
+            sprite = _starBottom;
+        }
+        else if (index != first)
+        {
+            sprite = _starMiddle;
+        }
+    }
+
+    private void StarFilling(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        source = null;
+        offset = Vector2.Zero;
+        sprite = _starFill;
+        float manaPerStar = _stats.ManaPerSegment;
+        float fill = (scale = Utils.GetLerpValue(manaPerStar * (float)index, manaPerStar * (float)(index + 1), _stats.Mana, clamped: true));
+        if (index == _lastStarFilling && fill > 0f)
+        {
+            scale += Main.cursorScale - 1f;
+        }
+    }
+
+    // Horizontal bars (HorizontalBarsPlayerResourcesDisplaySet): a life bar over a mana bar, right
+    // aligned, each a frame of segments filled from the left; textStyle 1 adds the life text, 2 the mana
+    // text too.
+
+    private void LayOutBars(Player player, int textStyle)
+    {
+        _stats = new PlayerStatsSnapshot(player);
+        _hpSegments = (int)((float)_stats.LifeMax / _stats.LifePerSegment);
+        _mpSegments = (int)((float)_stats.ManaMax / _stats.ManaPerSegment);
+        _hpPercent = (float)_stats.Life / (float)_stats.LifeMax;
+        _mpPercent = (float)_stats.Mana / (float)_stats.ManaMax;
+        int y = 18;
+        int x = Main.screenWidth - 300 - 22 + 16;
+        if (textStyle == 2)
+        {
+            y += 2;
+            LayOutLifeText(player, new Vector2(x, y) + new Vector2(130f, -20f));
+            string label = Lang.inter[2].Value + ":";
+            string value = player.statMana + "/" + player.statManaMax2;
+            Vector2 center = new Vector2(Main.screenWidth - 180, 65f);
+            Vector2 size = FontAssets.MouseText.Value.MeasureString(label + " " + value);
+            SetText(2, label, center + new Vector2((0f - size.X) * 0.5f, 0f));
+            SetText(3, value, center + new Vector2(size.X * 0.5f, 0f), rightAligned: true);
+        }
+        else if (textStyle == 1)
+        {
+            y += 4;
+            LayOutLifeText(player, new Vector2(x, y) + new Vector2(130f, -20f));
+        }
+        Vector2 lifeAnchor = new Vector2(x, y);
+        lifeAnchor.X += (20 - _hpSegments) * _panelMiddleHP.Width();
+        Lay(_life.Pieces, lifeAnchor, _hpSegments + 2, 0, _lifePanel, Vector2.Zero, Vector2.UnitX, Vector2.Zero);
+        Lay(_life.Pieces, lifeAnchor + new Vector2(6f, 6f), _hpSegments, 0, _lifeFilling, new Vector2(_hpFill.Width(), 0f), Vector2.Zero, Vector2.Zero);
+        Vector2 manaAnchor = new Vector2(x - 10, y + 24);
+        manaAnchor.X += (20 - _mpSegments) * _panelMiddleMP.Width();
+        Lay(_mana.Pieces, manaAnchor, _mpSegments + 2, 0, _manaPanel, Vector2.Zero, Vector2.UnitX, Vector2.Zero);
+        Lay(_mana.Pieces, manaAnchor + new Vector2(6f, 6f), _mpSegments, 0, _manaFilling, new Vector2(_mpFill.Width(), 0f), Vector2.Zero, Vector2.Zero);
+    }
+
+    private void BarPanel(int index, int first, int last, Asset<Texture2D> middle, Asset<Texture2D> right, Vector2 rightOffset, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        source = null;
+        offset = Vector2.Zero;
+        sprite = _panelLeft;
+        scale = 1f;
+        if (index == last)
+        {
+            sprite = right;
+            offset = rightOffset;
+        }
+        else if (index != first)
+        {
+            sprite = middle;
+        }
+    }
+
+    private void LifePanel(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        BarPanel(index, first, last, _panelMiddleHP, _panelRightHP, new Vector2(-16f, -10f), out sprite, out offset, out scale, out source);
+    }
+
+    private void ManaPanel(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        BarPanel(index, first, last, _panelMiddleMP, _panelRightMP, new Vector2(-16f, -6f), out sprite, out offset, out scale, out source);
+    }
+
+    private void LifeFilling(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        sprite = index >= _hpSegments - _stats.LifeFruitCount ? _hpFillHoney : _hpFill;
+        FillBar(index, sprite, _hpSegments, _hpPercent, out offset, out scale, out source);
+    }
+
+    private void ManaFilling(int index, int first, int last, out Asset<Texture2D> sprite, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        sprite = _mpFill;
+        FillBar(index, sprite, _mpSegments, _mpPercent, out offset, out scale, out source);
+    }
+
+    /// <summary>A bar segment cut to how full it is, from the left (the bar empties from the right).</summary>
+    private static void FillBar(int index, Asset<Texture2D> sprite, int segments, float fillPercent, out Vector2 offset, out float scale, out Rectangle? source)
+    {
+        offset = Vector2.Zero;
+        float perSegment = 1f / (float)segments;
+        float empty = Utils.GetLerpValue(perSegment * (float)index, perSegment * (float)(index + 1), 1f - fillPercent, clamped: true);
+        float fill = 1f - empty;
+        scale = 1f;
+        Rectangle frame = sprite.Frame();
+        int cut = (int)((float)frame.Width * (1f - fill));
+        offset.X += cut;
+        frame.X += cut;
+        frame.Width -= cut;
+        source = frame;
+    }
+}
