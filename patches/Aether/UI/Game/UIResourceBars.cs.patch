+/// <summary>
+/// The life or the mana display: its pieces, laid out afresh each frame, in pooled sprites. It counts
+/// as hovered over any piece's area (as ResourceDrawSettings tests it), or over <see cref="Area" />.
+/// </summary>
+public class UIResourceGroup : UIElement
+{
+    public readonly List<ResourcePiece> Pieces = new List<ResourcePiece>();
+
+    private readonly List<UIResourceSprite> _sprites = new List<UIResourceSprite>();
+
+    /// <summary>Instead of the pieces' areas, what counts as hovering (the classic style's rectangles).</summary>
+    public Func<Vector2, bool> Area;
+
+    /// <summary>Hands the laid out pieces to the sprites, in drawing order.</summary>
+    public void Sync()
+    {
+        while (_sprites.Count < Pieces.Count)
+        {
+            UIResourceSprite sprite = new UIResourceSprite();
+            _sprites.Add(sprite);
+            Append(sprite);
+        }
+        while (Elements.Count > Pieces.Count)
+        {
+            RemoveChild(Elements[Elements.Count - 1]);
+        }
+        for (int i = 0; i < Pieces.Count; i++)
+        {
+            if (_sprites[i].Parent == null)
+            {
+                Append(_sprites[i]);
+            }
+            _sprites[i].Piece = Pieces[i];
+        }
+    }
+
+    public override bool ContainsPoint(Vector2 point)
+    {
+        if (Area != null)
+        {
+            return Area(point);
+        }
+        Point mouse = point.ToPoint();
+        foreach (ResourcePiece piece in Pieces)
+        {
+            if (piece.Hit.Contains(mouse))
+            {
+                return true;
+            }
+        }
+        return false;
+    }
+}
