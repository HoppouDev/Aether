+    public override void UpdateState()
+    {
+        _style = Main.ResourceSetsManager.ActiveSetKeyName;
+        foreach (UIResourceText text in _texts)
+        {
+            text.Text = null;
+            text.RightAligned = false;
+        }
+        _life.Pieces.Clear();
+        _mana.Pieces.Clear();
+        _life.Area = null;
+        _mana.Area = null;
+        Player player = Main.LocalPlayer;
+        switch (_style)
+        {
+        case "Default":
+            LayOutClassic(player);
+            break;
+        case "New":
+        case "NewWithText":
+            LayOutFancy(player, _style == "NewWithText");
+            break;
+        default:
+            LayOutBars(player, _style == "HorizontalBarsWithFullText" ? 2 : _style == "HorizontalBarsWithText" ? 1 : 0);
