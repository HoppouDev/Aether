+/// <summary>
+/// The two crafting toggles beside the list: open the crafting grid (right-click switches between the
+/// classic and the modern grid) and craft from nearby chests. Drawn wherever the caller puts them.
+/// </summary>
+public static class CraftingToggles
+{
+    private static Point _gridToggle;
+
+    private static int _gridLinkPoint;
+
+    private static Point _nearbyToggle;
+
+    private static int _nearbyLinkPoint;
+
+    // A 30×30 area centred on the toggle, mouse strictly inside.
+    private static Rectangle Around(Point center)
+    {
+        return new Rectangle(center.X - 14, center.Y - 14, 29, 29);
+    }
+
+    private static readonly UIIconButtonScreen GridToggle = new UIIconButtonScreen(new UIIconButton
+    {
+        Area = () => Around(_gridToggle),
+        ConsumesClick = false,
+        WhileHovered = delegate
+        {
+            Main.instance.MouseTextNoOverride(Language.GetTextValue(CraftingUI.CraftingWindowTextTipKey), 0, 0);
+        },
+        OnPress = delegate
+        {
+            if (!Main.TryChangePipsPage(Main.PipPage.Recipes))
+            {
+                if (Player.Settings.CraftingGridControl == Player.Settings.CraftingGridMode.Classic)
+                {
+                    NewCraftingUI.Close(quiet: true, returnToInventory: true);
+                    Main.PipsUseGrid = !Main.PipsUseGrid;
+                }
+                else
+                {
+                    Main.PipsUseGrid = false;
+                    bool wasVisible = CraftingUI.AnyAdvancedGridVisible;
+                    NewCraftingUI.ToggleInInventory();
+                    if (wasVisible)
+                    {
+                        UILinkPointNavigator.ChangePoint(11001);
+                    }
+                }
+                Main.mouseLeftRelease = false;
+            }
+            SoundEngine.PlaySound(12);
+        },
+        OnRightPress = delegate
+        {
+            SoundEngine.PlaySound(12);
+            Player.Settings.CraftingGridControl = (Player.Settings.CraftingGridControl == Player.Settings.CraftingGridMode.Classic) ? Player.Settings.CraftingGridMode.Modern : Player.Settings.CraftingGridMode.Classic;
+        },
+        DrawIcon = delegate(SpriteBatch spriteBatch, Rectangle area, bool hovered)
+        {
+            UILinkPointNavigator.SetPosition(_gridLinkPoint, _gridToggle.ToVector2());
+            if (Main.PipsCurrentPage == Main.PipPage.Recipes)
+            {
+                Utils.DrawSelectedCraftingBarIndicator(spriteBatch, _gridToggle.X, _gridToggle.Y);
+            }
+            int frame = (Main.PipsCurrentPage == Main.PipPage.Recipes && Main.PipsUseGrid) ? 0 : (NewCraftingUI.Visible ? 4 : 2);
+            Texture2D texture = TextureAssets.CraftToggle[frame + (hovered ? 1 : 0)].Value;
+            spriteBatch.Draw(texture, _gridToggle.ToVector2(), null, Color.White, 0f, texture.Size() / 2f, 1f, SpriteEffects.None, 0f);
+        }
+    });
+
+    private static readonly UIIconButtonScreen NearbyToggle = new UIIconButtonScreen(new UIIconButton
+    {
+        Area = () => Around(_nearbyToggle),
+        ConsumesClick = false,
+        WhileHovered = delegate
+        {
+            Main.instance.MouseTextNoOverride(Language.GetTextValue(Player.Settings.CraftFromNearbyChests ? "GameUI.CraftFromNearbyChestsOn" : "GameUI.CraftFromNearbyChestsOff"), 0, 0);
+        },
+        OnPress = delegate
+        {
+            Player.Settings.CraftFromNearbyChests = !Player.Settings.CraftFromNearbyChests;
+            NewCraftingUI.RefreshGrid();
+            SoundEngine.PlaySound(12);
+            Main.SaveSettings();
+        },
+        DrawIcon = delegate(SpriteBatch spriteBatch, Rectangle area, bool hovered)
+        {
+            UILinkPointNavigator.SetPosition(_nearbyLinkPoint, _nearbyToggle.ToVector2());
+            Texture2D texture = TextureAssets.ChestCraft[2 - Player.Settings.CraftFromNearbyChests.ToInt() * 2 + (hovered ? 1 : 0)].Value;
+            spriteBatch.Draw(texture, _nearbyToggle.ToVector2(), null, Color.White, 0f, texture.Size() / 2f, 1f, SpriteEffects.None, 0f);
+        }
+    });
+
+    /// <summary>Called by CraftingUI.DrawGridToggle after it drops a stale recipe filter.</summary>
+    public static bool DrawGridToggle(int x, int y, int gamepadPointId)
+    {
+        _gridToggle = new Point(x, y);
+        _gridLinkPoint = gamepadPointId;
+        return GridToggle.Draw();
+    }
+
+    /// <summary>Called by CraftingUI.DrawCraftFromNearbyChestsToggle in place of its body.</summary>
+    public static bool DrawNearbyToggle(int x, int y, int gamepadPointId)
+    {
+        _nearbyToggle = new Point(x, y);
+        _nearbyLinkPoint = gamepadPointId;
+        return NearbyToggle.Draw();
+    }
+}
