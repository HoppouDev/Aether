+/// <summary>
+/// The classic crafting grid (CraftingUI.DrawRecipesGrid): every available recipe in rows, with up and
+/// down buttons; clicking one focuses it in the list and closes the grid.
+/// </summary>
+public class UIRecipeGrid : UICraftingScreen
+{
+    public static readonly UIRecipeGrid Instance = new UIRecipeGrid();
+
+    private const int Step = 42;
+
+    private const int GridLeft = 310;
+
+    private const int GridTop = 340;
+
+    public static bool Draw()
+    {
+        return Instance.DrawScreen();
+    }
+
+    private static bool ArrowHovered(int x, int y)
+    {
+        if (Main.mouseX >= x && Main.mouseX <= x + TextureAssets.CraftUpButton.Width() && Main.mouseY >= y && Main.mouseY <= y + TextureAssets.CraftUpButton.Height())
+        {
+            return !PlayerInput.IgnoreMouseInterface;
+        }
+        return false;
+    }
+
+    protected override void DrawIcons(SpriteBatch spriteBatch)
+    {
+        UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeBig = -1;
+        UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeSmall = -1;
+        Main.inventoryScale = 0.75f;
+        int perRow = (Main.screenWidth - GridLeft - 280) / Step;
+        int rows = (Main.screenHeight - GridTop - 20) / Step;
+        UILinkPointNavigator.Shortcuts.CRAFT_IconsPerRow = perRow;
+        UILinkPointNavigator.Shortcuts.CRAFT_IconsPerColumn = rows;
+        int count = Main.numAvailableRecipes;
+        if (Main.recStart > count - perRow * rows)
+        {
+            Main.recStart = Math.Max(0, count - perRow * rows);
+        }
+        int arrowX = GridLeft - 20;
+        int arrowY = GridTop + 2;
+        if (Main.recStart > 0)
+        {
+            if (ArrowHovered(arrowX, arrowY))
+            {
+                Main.LocalPlayer.mouseInterface = true;
+                if (Main.mouseLeftRelease && Main.mouseLeft)
+                {
+                    Main.recStart = Math.Max(0, Main.recStart - perRow);
+                    SoundEngine.PlaySound(12);
+                    Main.mouseLeftRelease = false;
+                }
+            }
+            spriteBatch.Draw(TextureAssets.CraftUpButton.Value, new Vector2(arrowX, arrowY), new Color(200, 200, 200, 200));
+        }
+        if (Main.recStart < count - perRow * rows)
+        {
+            arrowY += 20;
+            if (ArrowHovered(arrowX, arrowY))
+            {
+                Main.LocalPlayer.mouseInterface = true;
+                if (Main.mouseLeftRelease && Main.mouseLeft)
+                {
+                    Main.recStart += perRow;
+                    SoundEngine.PlaySound(12);
+                    if (Main.recStart > count - perRow)
+                    {
+                        Main.recStart = count - perRow;
+                    }
+                    Main.mouseLeftRelease = false;
+                }
+            }
+            spriteBatch.Draw(TextureAssets.CraftDownButton.Value, new Vector2(arrowX, arrowY), new Color(200, 200, 200, 200));
+        }
+        int column = 0;
+        int row = 0;
+        for (int i = Main.recStart; i < Recipe.maxRecipes && i < Main.numAvailableRecipes; i++)
+        {
+            Vector2 position = new Vector2(GridLeft + column * Step, GridTop + row * Step);
+            if (UICraftingIcon.IsHovered(position, Main.inventoryScale))
+            {
+                Main.LocalPlayer.mouseInterface = true;
+                if (Main.mouseLeftRelease && Main.mouseLeft)
+                {
+                    Main.focusRecipe = i;
+                    Main.PipsFastScroll = true;
+                    Main.PipsUseGrid = false;
+                    SoundEngine.PlaySound(12);
+                    Main.mouseLeftRelease = false;
+                    if (PlayerInput.UsingGamepadUI)
+                    {
+                        UILinkPointNavigator.ChangePage(9);
+                        Main.LockCraftingForThisCraftClickDuration();
+                    }
+                }
+                Main.craftingHide = true;
+                Item result = Main.recipe[Main.availableRecipe[i]].createItem;
+                Main.HoverItem = result.Clone();
+                ItemSlot.MouseHover(22);
+                Main.hoverItemName = result.Name + ((result.stack > 1) ? (" (" + result.stack + ")") : "");
+            }
+            UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeBig = i - Main.recStart;
+            NextIcon().DrawItem(spriteBatch, ref Main.recipe[Main.availableRecipe[i]].createItem, position, Main.inventoryBack.A);
+            if (++column >= perRow)
+            {
+                column = 0;
+                if (++row >= rows)
+                {
+                    break;
+                }
+            }
+        }
+    }
+}
