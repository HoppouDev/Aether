+/// <summary>
+/// A crafting item icon (a recipe's result or ingredient, context 22), placed by its list each frame;
+/// the list decides what hovering and clicking it does.
+/// </summary>
+public class UICraftingIcon : UIElement
+{
+    public UICraftingIcon()
+    {
+        IgnoresMouseInteraction = true;
+    }
+
+    /// <summary>Whether the mouse is on an icon at position and scale (edges included, as in the legacy loops).</summary>
+    public static bool IsHovered(Vector2 position, float scale)
+    {
+        if (Main.mouseX >= position.X && (float)Main.mouseX <= position.X + (float)TextureAssets.InventoryBack.Width() * scale && Main.mouseY >= position.Y && (float)Main.mouseY <= position.Y + (float)TextureAssets.InventoryBack.Height() * scale)
+        {
+            return !PlayerInput.IgnoreMouseInterface;
+        }
+        return false;
+    }
+
+    /// <summary>Draws item with a background of the given brightness (0 to 255).</summary>
+    public void DrawItem(SpriteBatch spriteBatch, ref Item item, Vector2 position, double backAlpha, Color lightColor = default(Color))
+    {
+        Left.Set(position.X, 0f);
+        Top.Set(position.Y, 0f);
+        Color saved = Main.inventoryBack;
+        byte alpha = (byte)Math.Max(0.0, backAlpha);
+        Main.inventoryBack = new Color(alpha, alpha, alpha, alpha);
+        ItemSlot.Draw(spriteBatch, ref item, 22, position, lightColor);
+        Main.inventoryBack = saved;
+    }
+}
