+/// <summary>
+/// The classic crafting list (CraftingUI.DrawRecipesList): available recipes in a column that scrolls
+/// to the focused one, which shrinks the further a recipe is from it; then the focused recipe's
+/// ingredients beside it.
+/// </summary>
+public class UIRecipeList : UICraftingScreen
+{
+    public static readonly UIRecipeList Instance = new UIRecipeList();
+
+    private int _adjY;
+
+    private int _middleY;
+
+    private Color _tipColor;
+
+    public static bool Draw(int adjY, int middleY, Color craftingTipColor)
+    {
+        Instance._adjY = adjY;
+        Instance._middleY = middleY;
+        Instance._tipColor = craftingTipColor;
+        return Instance.DrawScreen();
+    }
+
+    protected override void DrawIcons(SpriteBatch spriteBatch)
+    {
+        CraftingUI crafting = Main.craftingUI;
+        float[] recipeY = CraftingUI.availableRecipeY;
+        UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeBig = -1;
+        UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeSmall = -1;
+        if (Main.numAvailableRecipes > 0)
+        {
+            string text = (CraftingUI.RecipeFilterHack != null) ? CraftingUI.RecipeFilterHack.GetWindowDescription() : Lang.inter[25].Value;
+            spriteBatch.DrawString(FontAssets.MouseText.Value, text, new Vector2(76f, 414 + _adjY), _tipColor, 0f, default(Vector2), 1f, SpriteEffects.None, 0f);
+        }
+        crafting.AdjustRecipeOffsets();
+        for (int i = 0; i < Recipe.maxRecipes; i++)
+        {
+            if (i >= Main.numAvailableRecipes || Math.Abs(recipeY[i]) > (float)_middleY)
+            {
+                continue;
+            }
+            // Recipes shrink away from the focused one (all small while fast-scrolling).
+            float scale = Math.Max(0.75f, 100f / (Math.Abs(recipeY[i]) + 100f));
+            if (Main.PipsFastScroll)
+            {
+                scale = 0.75f;
+            }
+            Main.inventoryScale = scale;
+            crafting.GetItemSlotColors(_middleY, 100f, i, out var backAlpha, out var lightColor);
+            Vector2 position = new Vector2((int)(46f - 26f * scale), (int)(410f + recipeY[i] * scale - 30f * scale + (float)_adjY));
+            UICraftingIcon icon = NextIcon();
+            if (!Main.LocalPlayer.creativeInterface && UICraftingIcon.IsHovered(position, scale))
+            {
+                Main.HoverOverCraftingItemButton(i);
+            }
+            if (Main.numAvailableRecipes <= 0)
+            {
+                continue;
+            }
+            if (i == Main.focusRecipe)
+            {
+                UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeSmall = 0;
+                if (PlayerInput.SettingsForUI.HighlightThingsForMouse)
+                {
+                    ItemSlot.DrawGoldBGForCraftingMaterial = true;
+                }
+            }
+            else
+            {
+                UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeSmall = -1;
+            }
+            icon.DrawItem(spriteBatch, ref Main.recipe[Main.availableRecipe[i]].createItem, position, backAlpha - 50.0, lightColor);
+        }
+        Main.inventoryScale = 0.6f;
+        if (Main.numAvailableRecipes <= 0)
+        {
+            return;
+        }
+        UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeBig = -1;
+        UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeSmall = -1;
+        for (int j = 0; j < Recipe.maxRequirements; j++)
+        {
+            Recipe recipe = Main.recipe[Main.availableRecipe[Main.focusRecipe]];
+            Item ingredient = recipe.requiredItem[j];
+            if (ingredient.type == 0)
+            {
+                UILinkPointNavigator.Shortcuts.CRAFT_CurrentIngredientsCount = j + 1;
+                break;
+            }
+            // Ingredients fade out while the list scrolls away from the focused recipe.
+            double backAlpha = (float)(Main.inventoryBack.A + 50) - Math.Abs(recipeY[Main.focusRecipe]) * 2f;
+            if (backAlpha == 0.0)
+            {
+                break;
+            }
+            Vector2 position = new Vector2(80 + j * 40, 380 + _adjY);
+            if (UICraftingIcon.IsHovered(position, Main.inventoryScale))
+            {
+                Main.craftingHide = true;
+                Main.LocalPlayer.mouseInterface = true;
+                ItemSlot.HoverOverrideClick(ingredient, 22);
+                CraftingUI.SetRecipeMaterialDisplayName(recipe, ingredient);
+            }
+            UILinkPointNavigator.Shortcuts.CRAFT_CurrentRecipeSmall = 1 + j;
+            NextIcon().DrawItem(spriteBatch, ref ingredient, position, backAlpha - 50.0);
+        }
+    }
+}
