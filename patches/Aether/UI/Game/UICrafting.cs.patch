+/// <summary>A screen whose icons are pooled and placed while drawing (the crafting lists scroll and animate).</summary>
+public abstract class UICraftingScreen : UIGameScreen
+{
+    private readonly List<UICraftingIcon> _icons = new List<UICraftingIcon>();
+
+    private int _used;
+
+    protected UICraftingIcon NextIcon()
+    {
+        if (_used >= _icons.Count)
+        {
+            UICraftingIcon icon = new UICraftingIcon();
+            _icons.Add(icon);
+            Append(icon);
+        }
+        return _icons[_used++];
+    }
+
+    protected abstract void DrawIcons(SpriteBatch spriteBatch);
+
+    protected override void DrawChildren(SpriteBatch spriteBatch)
+    {
+        _used = 0;
+        DrawIcons(spriteBatch);
+    }
+
+    /// <summary>Called by the legacy method in place of its body; false: run the legacy body.</summary>
+    protected bool DrawScreen()
+    {
+        InGamePreview.Update();
+        if (!UIInventorySlots.Enabled)
+        {
+            return false;
+        }
+        GameScreens.Draw(this, Main.spriteBatch);
+        return true;
+    }
+}
