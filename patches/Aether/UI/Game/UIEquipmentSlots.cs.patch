--- /dev/null
+++ b/Aether/UI/Game/UIEquipmentSlots.cs
@@ -0,0 +1,204 @@
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using Terraria;
+using Terraria.GameContent;
+using Terraria.GameInput;
+using Terraria.Localization;
+using Terraria.UI.Gamepad;
+
+namespace Aether.UI.Game;
+
+/// <summary>
+/// The open inventory's equipment page (Main.DrawInventory, EquipPage 0): armour and accessories,
+/// vanity, and dye columns with the accessory visibility toggles, plus what's drawn among them (loadout
+/// buttons, defense counter, the small achievement advisor). Locked slots get the dimmed background.
+/// </summary>
+public class UIEquipmentSlots : UIGameScreen
+{
+    public static readonly UIEquipmentSlots Instance = new UIEquipmentSlots();
+
+    private const int AccessoryGap = 4;
+
+    private int _top;
+
+    private int _slotCount;
+
+    // What the slots were last built for.
+    private bool _built;
+
+    private int _builtWidth;
+
+    private int _builtTop;
+
+    private int _builtSlotCount;
+
+    private float _builtScale;
+
+    private bool _builtDemonHeart;
+
+    private bool _builtMasterMode;
+
+    private bool _demonHeart;
+
+    private bool _masterMode;
+
+    private int _defenseRow;
+
+    private int _advisorRow;
+
+    private float _savedScale;
+
+    private Color _savedBack;
+
+    /// <summary>
+    /// Called by Main.DrawInventory in place of the equipment page; top is the page's top edge and
+    /// slotCount its row count. False: draw the legacy page.
+    /// </summary>
+    public static bool Draw(int top, int slotCount)
+    {
+        InGamePreview.Update();
+        if (!UIInventorySlots.Enabled)
+        {
+            return false;
+        }
+        Instance._top = top;
+        Instance._slotCount = slotCount;
+        GameScreens.Draw(Instance, Main.spriteBatch);
+        return true;
+    }
+
+    private int ColumnX(int column)
+    {
+        return Main.screenWidth - 64 - 28 - 47 * column;
+    }
+
+    public override void UpdateState()
+    {
+        Player player = Main.LocalPlayer;
+        _savedScale = Main.inventoryScale;
+        _savedBack = Main.inventoryBack;
+        _demonHeart = player.CanDemonHeartAccessoryBeShown();
+        _masterMode = player.CanMasterModeAccessoryBeShown();
+        if (!_built || _builtWidth != Main.screenWidth || _builtTop != _top || _builtSlotCount != _slotCount || _builtScale != Main.inventoryScale || _builtDemonHeart != _demonHeart || _builtMasterMode != _masterMode)
+        {
+            _built = true;
+            _builtWidth = Main.screenWidth;
+            _builtTop = _top;
+            _builtSlotCount = _slotCount;
+            _builtScale = Main.inventoryScale;
+            _builtDemonHeart = _demonHeart;
+            _builtMasterMode = _masterMode;
+            Build();
+            Recalculate();
+        }
+        _defenseRow = _slotCount - 1 - (Main._settingsButtonIsPushedToSide ? 1 : 0);
+        _advisorRow = Main.HasSpaceForControllerAchievementAdvisor ? (_defenseRow - 1) : (-1);
+        // The columns' areas, gaps included, keep clicks off the world.
+        if (PlayerInput.IgnoreMouseInterface)
+        {
+            return;
+        }
+        int x = ColumnX(0);
+        if (Main.mouseX > x && Main.mouseX < (int)((float)x + 56f * Main.inventoryScale) && Main.mouseY > _top && Main.mouseY < (int)((float)_top + 448f * Main.inventoryScale))
+        {
+            player.mouseInterface = true;
+        }
+        x = ColumnX(1);
+        if (Main.mouseX > x && Main.mouseX < (int)((float)(Main.screenWidth - 64 - 20 - 47) + 56f * Main.inventoryScale) && Main.mouseY > _top && Main.mouseY < (int)((float)_top + 168f * Main.inventoryScale))
+        {
+            player.mouseInterface = true;
+        }
+    }
+
+    private bool Shown(int slot)
+    {
+        int accessory = slot % 10;
+        if (accessory != 8 || _demonHeart)
+        {
+            return accessory != 9 || _masterMode;
+        }
+        return false;
+    }
+
+    private void Build()
+    {
+        RemoveAllChildren();
+        float scale = Main.inventoryScale;
+        int row = -1;
+        for (int i = 0; i < 10; i++)
+        {
+            if (!Shown(i))
+            {
+                continue;
+            }
+            row++;
+            int y = (int)((float)_top + (float)(row * 56) * scale) + ((i > 2) ? AccessoryGap : 0);
+            AddSlot(() => Main.LocalPlayer.armor, i, (i > 2) ? 10 : 8, new Vector2(ColumnX(0), y), scale);
+            AddSlot(() => Main.LocalPlayer.armor, 10 + i, (i > 2) ? 11 : 9, new Vector2(ColumnX(1), y), scale);
+            AddSlot(() => Main.LocalPlayer.dye, i, 12, new Vector2(ColumnX(2), y), scale);
+            if (i > 2)
+            {
+                int accessory = i;
+                UIEquipToggle toggle = new UIEquipToggle(() => Main.LocalPlayer.hideVisibleAccessory[accessory] ? TextureAssets.InventoryTickOff.Value : TextureAssets.InventoryTickOn.Value, () => !Main.LocalPlayer.hideVisibleAccessory[accessory], delegate
+                {
+                    Main.LocalPlayer.hideVisibleAccessory[accessory] = !Main.LocalPlayer.hideVisibleAccessory[accessory];
+                }, (int state) => Lang.inter[58 + state].Value, Color.White * 0.7f);
+                Texture2D tick = TextureAssets.InventoryTickOn.Value;
+                toggle.Place(new Rectangle(Main.screenWidth - 58, (int)((float)(_top - 2) + (float)(row * 56) * scale) + AccessoryGap, tick.Width, tick.Height));
+                Append(toggle);
+            }
+        }
+    }
+
+    private void AddSlot(System.Func<Item[]> items, int slot, int context, Vector2 position, float scale)
+    {
+        int unlockIndex = slot % 10;
+        UIGameItemSlot uIGameItemSlot = new UIGameItemSlot(items, slot, context)
+        {
+            BeforeHandle = delegate
+            {
+                Main.armorHide = true;
+                return Main.LocalPlayer.IsItemSlotUnlockedAndUsable((context == 12) ? unlockIndex : slot) || Main.mouseItem.IsAir;
+            },
+            BeforeDraw = delegate
+            {
+                Main.inventoryBack = Main.LocalPlayer.IsItemSlotUnlockedAndUsable((context == 12) ? unlockIndex : slot) ? Instance._savedBack : new Color(80, 80, 80, 80);
+            }
+        };
+        uIGameItemSlot.Place(position, scale);
+        Append(uIGameItemSlot);
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        Main.DrawLoadoutButtons(_top, _demonHeart, _masterMode);
+        int row = -1;
+        for (int i = 0; i < 10; i++)
+        {
+            if (!Shown(i))
+            {
+                continue;
+            }
+            row++;
+            int x = ColumnX(0);
+            int y = (int)((float)_top + (float)(row * 56) * Main.inventoryScale) + ((i > 2) ? AccessoryGap : 0);
+            if (row == _advisorRow && !Main.instance._achievementAdvisor.CanDrawAboveCoins)
+            {
+                Vector2 position = new Vector2(x - 10 - 47 - 47 - 14 - 14, y + 8);
+                Main.instance._achievementAdvisor.DrawOneAchievement(spriteBatch, position, large: false);
+                UILinkPointNavigator.SetPosition(1570, position + new Vector2(20f) * Main.inventoryScale);
+            }
+            if (row == _defenseRow)
+            {
+                Main.DrawDefenseCounter(x, y);
+            }
+        }
+    }
+
+    protected override void DrawChildren(SpriteBatch spriteBatch)
+    {
+        base.DrawChildren(spriteBatch);
+        Main.inventoryBack = _savedBack;
+        Main.inventoryScale = _savedScale;
+    }
+}
