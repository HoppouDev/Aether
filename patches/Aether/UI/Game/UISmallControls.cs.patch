+/// <summary>
+/// The "Settings" text button at the bottom right (Main.DrawSettingButton, from
+/// DrawInterface_29_SettingsButton): outlined DeathText sized like "Settings" in MouseText, growing while
+/// hovered; with a gamepad, the full-map button's glyph beside it, and that button presses it too.
+/// </summary>
+public class UISettingsButton : UIGameScreen
+{
+    public static readonly UISettingsButton Instance = new UISettingsButton();
+
+    private Point _position;
+
+    private string _text;
+
+    private string _sizeMatcher;
+
+    private Action _onClick;
+
+    internal override string AutomationLabel => _text;
+
+    internal Rectangle AutomationBounds { get; private set; }
+
+    internal void Activate() => _onClick();
+
+    /// <summary>Called by Main.DrawSettingButton in place of its body (it keeps its state in Main.mouseExit/exitScale).</summary>
+    public static bool Draw(int x, int y, string text, string sizeMatcher, Action onClick)
+    {
+        InGamePreview.Update();
+        if (!UIInventorySlots.Enabled)
+        {
+            return false;
+        }
+        Instance._position = new Point(x, y);
+        Instance._text = text;
+        Instance._sizeMatcher = sizeMatcher;
+        Instance._onClick = onClick;
+        GameScreens.Draw(Instance, Main.spriteBatch);
+        return true;
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        DynamicSpriteFont mouseFont = FontAssets.MouseText.Value;
+        DynamicSpriteFont deathFont = FontAssets.DeathText.Value;
+        float fit = mouseFont.MeasureString(_sizeMatcher).X / mouseFont.MeasureString(_text).X;
+        Vector2 size = deathFont.MeasureString(_text);
+        if (Main.mouseExit)
+        {
+            if ((double)Main.exitScale < 0.96)
+            {
+                Main.exitScale += 0.02f;
+            }
+        }
+        else if ((double)Main.exitScale > 0.8)
+        {
+            Main.exitScale -= 0.02f;
+        }
+        UILinkPointNavigator.SetPosition(308, _position.ToVector2());
+        float scale = (Main.exitScale - 0.2f) * fit;
+        AutomationBounds = Utils.CenteredRectangle(_position.ToVector2(), size * scale);
+        for (int i = 0; i < 5; i++)
+        {
+            Vector2 offset = i switch
+            {
+                0 => new Vector2(-2f, 0f),
+                1 => new Vector2(2f, 0f),
+                2 => new Vector2(0f, -2f),
+                3 => new Vector2(0f, 2f),
+                _ => Vector2.Zero
+            };
+            spriteBatch.DrawString(deathFont, _text, _position.ToVector2() + offset, (i == 4) ? Color.White : Color.Black, 0f, size / 2f, scale, SpriteEffects.None, 0f);
+        }
+        bool pressed = false;
+        if (PlayerInput.UsingGamepad)
+        {
+            TextSnippet glyph = GlyphTagHandler.GetGlyph(PlayerInput.ProfileGamepadUI.KeyStatus["MapFull"][0]);
+            float glyphScale = scale / 0.6f;
+            glyph.UniqueDraw(justCheckingSize: false, out var _, spriteBatch, new Vector2((float)_position.X - size.X / 2f * scale - 32f * glyphScale, (float)_position.Y - size.Y / 2f * scale + 2f * glyphScale), Color.White, glyphScale);
+            pressed = PlayerInput.Triggers.JustPressed.MapFull;
+        }
+        // The unscaled DeathText area, a little short at the bottom; only if nothing else has the mouse.
+        bool hovered = (float)Main.mouseX > (float)_position.X - size.X / 2f && (float)Main.mouseX < (float)_position.X + size.X / 2f && (float)Main.mouseY > (float)_position.Y - size.Y / 2f && (float)Main.mouseY < (float)_position.Y + size.Y / 2f - 10f && !Main.LocalPlayer.mouseInterface;
+        if (hovered)
+        {
+            if (!PlayerInput.IgnoreMouseInterface)
+            {
+                if (!Main.mouseExit)
+                {
+                    SoundEngine.PlaySound(12);
+                }
+                Main.mouseExit = true;
+                Main.LocalPlayer.mouseInterface = true;
+                if (Main.mouseLeftRelease && Main.mouseLeft)
+                {
+                    Main.mouseExit = false;
+                    Main.exitScale = 0.8f;
+                    pressed = true;
+                }
+            }
+        }
+        else
+        {
+            Main.mouseExit = false;
+        }
+        if (pressed)
+        {
+            _onClick();
+        }
+    }
+}
+
+/// <summary>The Goblin Tinkerer's reforge button (in Main.DrawInventory): pays the price and reforges.</summary>
+public static class ReforgeButton
+{
+    private static Point _center;
+
+    private static long _price;
+
+    private static readonly UIIconButtonScreen Screen = new UIIconButtonScreen(new UIIconButton
+    {
+        // Strictly within 15 pixels of the centre.
+        Area = () => new Rectangle(_center.X - 14, _center.Y - 14, 29, 29),
+        ConsumesClick = false,
+        // It ticks only when the hover starts, through Main.mouseReforge (which also drives its growth).
+        TickOnHover = false,
+        WhileHovered = delegate
+        {
+            Main.hoverItemName = Lang.inter[19].Value;
+            if (!Main.mouseReforge)
+            {
+                SoundEngine.PlaySound(12);
+            }
+            Main.mouseReforge = true;
+        },
+        OnPress = delegate
+        {
+            if (Main.reforgeCooldown <= 0 && Main.LocalPlayer.BuyItem(_price))
+            {
+                Main.ReforgeItemInReforgeSlot();
+            }
+        },
+        DrawIcon = delegate(SpriteBatch spriteBatch, Rectangle area, bool hovered)
+        {
+            if (!hovered)
+            {
+                Main.mouseReforge = false;
+            }
+            Texture2D texture = TextureAssets.Reforge[hovered ? 1 : 0].Value;
+            spriteBatch.Draw(texture, _center.ToVector2(), null, Color.White, 0f, texture.Size() / 2f, Main.reforgeScale, SpriteEffects.None, 0f);
+            UILinkPointNavigator.SetPosition(304, _center.ToVector2() + texture.Size() / 4f);
+        }
+    });
+
+    /// <summary>Called by Main.DrawInventory in place of the reforge button's legacy code.</summary>
+    public static bool Draw(int x, int y, long price)
+    {
+        _center = new Point(x, y);
+        _price = price;
+        return Screen.Draw();
+    }
+}
