+using System;
+using Aether.UI.Menu;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using ReLogic.Content;
+using ReLogic.Graphics;
+using Terraria;
+using Terraria.Audio;
+using Terraria.GameContent;
+using Terraria.GameInput;
+using Terraria.Localization;
+using Terraria.UI;
+using Terraria.UI.Gamepad;
+
+namespace Aether.UI.Game;
+
+/// <summary>
+/// A text choice in the stylist and dresser windows (Buy / Cancel): outlined text that grows and turns
+/// brown-shadowed while hovered, ticking as the hover starts and ends. Its focus lives in the legacy
+/// field the window's click handling reads (Main.npcChatFocus1/2).
+/// </summary>
+public class UIWindowChoice : UIElement
+{
+    private readonly Func<bool> _getFocus;
+
+    private readonly Action<bool> _setFocus;
+
+    private readonly int _linkPoint;
+
+    public UIWindowChoice(Func<bool> getFocus, Action<bool> setFocus, int linkPoint)
+    {
+        _getFocus = getFocus;
+        _setFocus = setFocus;
+        _linkPoint = linkPoint;
+        IgnoresMouseInteraction = true;
+    }
+
+    /// <summary>Draws text at position; enabled: whether it can be hovered (Buy is only while something costs money).</summary>
+    public void DrawChoice(SpriteBatch spriteBatch, string text, Vector2 position, Color color, bool enabled)
+    {
+        DynamicSpriteFont font = FontAssets.MouseText.Value;
+        Vector2 size = font.MeasureString(text);
+        bool hovered = enabled && Main.mouseX > position.X && (float)Main.mouseX < position.X + size.X && Main.mouseY > position.Y && (float)Main.mouseY < position.Y + size.Y;
+        if (hovered != _getFocus())
+        {
+            SoundEngine.PlaySound(12);
+        }
+        _setFocus(hovered);
+        if (hovered)
+        {
+            Main.LocalPlayer.releaseUseItem = false;
+        }
+        Vector2 half = size * 0.5f;
+        UILinkPointNavigator.SetPosition(_linkPoint, position + half);
+        for (int i = 0; i < 5; i++)
+        {
+            Vector2 offset = i switch
+            {
+                0 => new Vector2(-2f, 0f),
+                1 => new Vector2(2f, 0f),
+                2 => new Vector2(0f, -2f),
+                3 => new Vector2(0f, 2f),
+                _ => Vector2.Zero
+            };
+            Color shadow = hovered ? Color.Brown : Color.Black;
+            spriteBatch.DrawString(font, text, position + offset + half, (i == 4) ? color : shadow, 0f, half, hovered ? 1.1f : 0.9f, SpriteEffects.None, 0f);
+        }
+    }
+}
+
+/// <summary>
+/// The Stylist's hair window (Main.DrawHairWindow): 15 hairstyles at a time (scroll with the arrows or
+/// the wheel), HSL bars for the hair colour, and Buy (its price shown) or Cancel.
+/// </summary>
+public class UIStylistWindow : UIGameScreen
+{
+    public static readonly UIStylistWindow Instance = new UIStylistWindow();
+
+    private const int Columns = 5;
+
+    private const int Shown = 15;
+
+    private Point _origin;
+
+    private int _price;
+
+    private UIMenuColorBars _bars;
+
+    private UIWindowChoice _buy;
+
+    private UIWindowChoice _cancel;
+
+    private UIIconButton _left;
+
+    private UIIconButton _right;
+
+    /// <summary>Called by Main.DrawHairWindow in place of its body (after the window-closing checks).</summary>
+    public static bool Draw()
+    {
+        InGamePreview.Update();
+        if (!UIInventorySlots.Enabled)
+        {
+            return false;
+        }
+        GameScreens.Draw(Instance, Main.spriteBatch);
+        return true;
+    }
+
+    private Point StylesTopLeft => new Point(_origin.X + 234, _origin.Y + 18);
+
+    public override void OnInitialize()
+    {
+        _bars = new UIMenuColorBars(withAlpha: false, 0.15f)
+        {
+            HAlign = 0f,
+            LinkPointBase = 2600
+        };
+        Append(_bars);
+        _buy = new UIWindowChoice(() => Main.npcChatFocus1, delegate(bool focus)
+        {
+            Main.npcChatFocus1 = focus;
+        }, 2603);
+        _cancel = new UIWindowChoice(() => Main.npcChatFocus2, delegate(bool focus)
+        {
+            Main.npcChatFocus2 = focus;
+        }, 2604);
+        Append(_buy);
+        Append(_cancel);
+        _left = ScrollArrow(left: true);
+        _right = ScrollArrow(left: false);
+        Append(_left);
+        Append(_right);
+    }
+
+    private UIIconButton ScrollArrow(bool left)
+    {
+        return new UIIconButton
+        {
+            Area = delegate
+            {
+                Point styles = StylesTopLeft;
+                return new Rectangle(styles.X - 18 + (left ? 0 : 296), styles.Y + 74, TextureAssets.CraftUpButton.Width(), TextureAssets.CraftUpButton.Height());
+            },
+            IncludeFarEdges = true,
+            CanHover = () => left ? (Main.hairStart >= 1) : (Main.hairStart + Shown < Main.Hairstyles.AvailableHairstyles.Count),
+            ConsumesClick = false,
+            TickOnHover = false,
+            OnPress = delegate
+            {
+                Main.hairStart += left ? (-Shown) : Shown;
+                SoundEngine.PlaySound(12);
+            },
+            DrawIcon = delegate(SpriteBatch spriteBatch, Rectangle area, bool hovered)
+            {
+                bool shown = left ? (Main.hairStart >= 1) : (Main.hairStart + Shown < Main.Hairstyles.AvailableHairstyles.Count);
+                if (shown)
+                {
+                    spriteBatch.Draw((left ? TextureAssets.ScrollLeftButton : TextureAssets.ScrollRightButton).Value, new Vector2(area.X, area.Y), new Color(200, 200, 200, 200));
+                }
+            }
+        };
+    }
+
+    public override void UpdateState()
+    {
+        Main.Hairstyles.UpdateUnlocks();
+        Texture2D back = TextureAssets.HairStyleBack.Value;
+        _origin = new Point(Main.screenWidth / 2 - back.Width / 2, Main.screenHeight / 2 + 60);
+        Main.selColor = Main.LocalPlayer.hairColor;
+        // Opening the window resets the bars to -1; reload them then (any of them, as in the legacy code).
+        if (Main.hBar == -1f || Main.sBar == -1f || Main.lBar == -1f)
+        {
+            _bars.Load();
+        }
+        _bars.Left.Set(_origin.X + 22, 0f);
+        _bars.Top.Set(_origin.Y + 42, 0f);
+        _bars.Recalculate();
+        Rectangle area = new Rectangle(_origin.X, _origin.Y, back.Width, back.Height);
+        // The wheel scrolls a row (5 styles) at a time.
+        if (area.Contains(Main.MouseScreen.ToPoint()))
+        {
+            int steps = -PlayerInput.ScrollWheelDelta / 120;
+            while (steps != 0)
+            {
+                Main.hairStart += 5 * Math.Sign(steps);
+                SoundEngine.PlaySound(12);
+                steps -= Math.Sign(steps);
+            }
+        }
+        if (Main.mouseX > area.X && Main.mouseX < area.Right && Main.mouseY > area.Y && Main.mouseY < area.Bottom)
+        {
+            Main.LocalPlayer.mouseInterface = true;
+        }
+        _price = Price();
+    }
+
+    // 10 gold for a new style, 2 for a new colour, with the usual discounts, rounded to gold.
+    private static int Price()
+    {
+        Player player = Main.LocalPlayer;
+        int price = 0;
+        if (Main.oldHairStyle != player.hair)
+        {
+            price += 100000;
+        }
+        if (Main.oldHairColor != player.hairColor)
+        {
+            price += 20000;
+        }
+        if (player.discountAvailable)
+        {
+            price = (int)((float)price * 0.8f);
+        }
+        price = (int)((float)price * player.currentShoppingSettings.PriceAdjustment);
+        return Math.Max(0, (int)Math.Round((float)price / 10000f) * 10000);
+    }
+
+    internal static string PriceText(int price)
+    {
+        if (price == 0)
+        {
+            return Language.GetTextValue("GameUI.Buy");
+        }
+        string coins = "";
+        int[] split = Utils.CoinsSplit(price);
+        for (int i = 3; i >= 0; i--)
+        {
+            if (split[i] > 0)
+            {
+                coins = coins + split[i] + " " + Lang.inter[15 + (3 - i)].Value + " ";
+            }
+        }
+        return Language.GetTextValue("GameUI.BuyWithValue", coins);
+    }
+
+    protected override void DrawSelf(SpriteBatch spriteBatch)
+    {
+        Texture2D back = TextureAssets.HairStyleBack.Value;
+        spriteBatch.Draw(back, _origin.ToVector2(), new Color(200, 200, 200, 200));
+    }
+
+    protected override void DrawChildren(SpriteBatch spriteBatch)
+    {
+        _left.Recalculate();
+        _right.Recalculate();
+        foreach (UIElement arrow in new UIElement[2] { _left, _right })
+        {
+            arrow.Draw(spriteBatch);
+        }
+        int count = Main.Hairstyles.AvailableHairstyles.Count;
+        Main.hairStart = Math.Max(0, Math.Min(Main.hairStart, count - Shown));
+        int grey = (Main.mouseTextColor * 2 + 255) / 3;
+        Color color = new Color(grey, (int)((double)grey / 1.1), grey / 2, grey);
+        Vector2 buyAt = new Vector2(_origin.X + 18, _origin.Y + 156);
+        if (_price > 0)
+        {
+            ItemSlot.DrawSavings(spriteBatch, buyAt.X, buyAt.Y - 70f, horizontal: true);
+        }
+        _buy.DrawChoice(spriteBatch, PriceText(_price), buyAt, (_price != 0) ? color : new Color(100, 100, 100), _price > 0);
+        _cancel.DrawChoice(spriteBatch, Language.GetTextValue("GameUI.Cancel"), buyAt + new Vector2(130f, 0f), color, enabled: true);
+        if (Main.mouseLeft && Main.mouseLeftRelease)
+        {
+            if (Main.npcChatFocus1)
+            {
+                if (Main.LocalPlayer.BuyItem(_price))
+                {
+                    Main.BuyHairWindow();
+                    return;
+                }
+            }
+            else if (Main.npcChatFocus2)
+            {
+                Main.CancelHairWindow();
+                return;
+            }
+        }
+        // (The bars track their own drag, so only the mouse block needs resetting.)
+        if (!Main.mouseLeft)
+        {
+            Main.blockMouse = false;
+        }
+        _bars.Draw(spriteBatch);
+        Main.LocalPlayer.hairColor = Main.selColor;
+        DrawStyles(spriteBatch);
+    }
+
+    private void DrawStyles(SpriteBatch spriteBatch)
+    {
+        Player player = Main.LocalPlayer;
+        Point topLeft = StylesTopLeft;
+        Texture2D slot = TextureAssets.InventoryBack.Value;
+        for (int i = 0; i < Shown; i++)
+        {
+            int style = Main.Hairstyles.AvailableHairstyles[Main.hairStart + i];
+            Vector2 position = new Vector2(topLeft.X + i % Columns * 56, topLeft.Y + i / Columns * 56);
+            UILinkPointNavigator.SetPosition(2605 + i, position + slot.Size() * 0.75f);
+            spriteBatch.Draw((player.hair == style) ? TextureAssets.InventoryBack14.Value : TextureAssets.InventoryBack8.Value, position, new Rectangle(0, 0, slot.Width, slot.Height), new Color(200, 200, 200, 200));
+            if (Main.mouseX > position.X && Main.mouseX < position.X + slot.Width && Main.mouseY > position.Y && Main.mouseY < position.Y + slot.Height)
+            {
+                Asset<Texture2D> border = Main.Assets.Request<Texture2D>("Images/UI/PanelBorder");
+                Utils.DrawSplicedPanel(spriteBatch, border.Value, (int)position.X, (int)position.Y, slot.Width, slot.Height, border.Width() / 2 - 1, border.Width() / 2 - 1, border.Height() / 2 - 1, border.Height() / 2 - 1, Main.OurFavoriteColor);
+                if (Main.mouseLeft && Main.mouseLeftRelease)
+                {
+                    Main.mouseLeftRelease = false;
+                    player.hair = style;
+                    SoundEngine.PlaySound(12);
+                }
+            }
+            // A bald head with this hair, in the chosen colour.
+            Main.instance.LoadHair(style);
+            Texture2D hair = TextureAssets.PlayerHair[style].Value;
+            Vector2 head = new Vector2(position.X + slot.Width / 2 - hair.Width / 2, position.Y + 4f);
+            Rectangle frame = new Rectangle(0, 0, hair.Width, 56);
+            spriteBatch.Draw(TextureAssets.Players[0, 0].Value, head, frame, player.skinColor);
+            spriteBatch.Draw(TextureAssets.Players[0, 1].Value, head, frame, Color.White);
+            spriteBatch.Draw(TextureAssets.Players[0, 2].Value, head, frame, player.eyeColor);
+            spriteBatch.Draw(hair, head + player.GetHairDrawOffset(style, hatHair: false) * player.Directions, frame, Main.selColor);
+        }
+    }
+}
