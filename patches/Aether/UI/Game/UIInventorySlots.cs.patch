+using Microsoft.Xna.Framework;
+using Terraria;
+using Terraria.GameInput;
+
+namespace Aether.UI.Game;
+
+/// <summary>
+/// The open inventory's item slots (Main.DrawInventory): the 50-slot main grid, the coin and ammo
+/// columns, and the trash slot. Each part is its own screen, drawn where the legacy code drew it.
+/// </summary>
+public static class UIInventorySlots
+{
+    public static readonly UIInventoryGrid Grid = new UIInventoryGrid();
+
+    public static readonly UICoinAmmoSlots CoinsAndAmmo = new UICoinAmmoSlots();
+
+    public static readonly UITrashSlot Trash = new UITrashSlot();
+
+    /// <summary>False: Main.DrawInventory draws its legacy slot loops instead (for comparing them).</summary>
+    public static bool Enabled = true;
+
+    /// <summary>Called by Main.DrawInventory in place of its main grid loop; false: draw the legacy one.</summary>
+    public static bool DrawGrid()
+    {
+        return Draw(Grid);
+    }
+
+    /// <summary>Called by Main.DrawInventory in place of its coin loop (the ammo loop checks Enabled).</summary>
+    public static bool DrawCoinsAndAmmo()
+    {
+        return Draw(CoinsAndAmmo);
+    }
+
+    /// <summary>Called by Main.DrawTrashItemSlot in place of its body.</summary>
+    public static bool DrawTrash()
+    {
+        return Draw(Trash);
+    }
+
+    private static bool Draw(UIGameScreen screen)
+    {
+        InGamePreview.Update();
+        if (!Enabled)
+        {
+            return false;
+        }
+        GameScreens.Draw(screen, Main.spriteBatch);
+        return true;
+    }
+}
+
+/// <summary>The 10×5 main inventory grid (context 0), at 0.85 scale from (20, 20).</summary>
+public class UIInventoryGrid : UIGameScreen
+{
+    private const float Scale = 0.85f;
+
+    public override void OnInitialize()
+    {
+        for (int i = 0; i < 10; i++)
+        {
+            for (int j = 0; j < 5; j++)
+            {
+                int slot = i + j * 10;
+                UIGameItemSlot uIGameItemSlot = new UIGameItemSlot(() => Main.player[Main.myPlayer].inventory, slot, 0)
+                {
+                    // A slot that was filled from a chest stack is marked; once empty, it's normal again.
+                    BeforeHandle = delegate
+                    {
+                        Player player = Main.player[Main.myPlayer];
+                        if (player.inventoryChestStack[slot] && player.inventory[slot].IsAir)
+                        {
+                            player.inventoryChestStack[slot] = false;
+                        }
+                        return !player.inventoryChestStack[slot];
+                    }
+                };
+                uIGameItemSlot.Place(new Vector2((int)(20f + (float)(i * 56) * Scale), (int)(20f + (float)(j * 56) * Scale)), Scale);
+                Append(uIGameItemSlot);
+            }
+        }
+    }
+
+    public override void UpdateState()
+    {
+        Main.inventoryScale = Scale;
+        // The whole grid area, gaps included, keeps clicks off the world.
+        if (Main.mouseX > 20 && Main.mouseX < (int)(20f + 560f * Scale) && Main.mouseY > 20 && Main.mouseY < (int)(20f + 280f * Scale) && !PlayerInput.IgnoreMouseInterface)
+        {
+            Main.player[Main.myPlayer].mouseInterface = true;
+        }
+    }
+
+}
+
+/// <summary>The coin (context 1, slots 50 to 53) and ammo (context 2, 54 to 57) columns, at 0.6 scale.</summary>
+public class UICoinAmmoSlots : UIGameScreen
+{
+    private const float Scale = 0.6f;
+
+    public override void OnInitialize()
+    {
+        for (int i = 0; i < 4; i++)
+        {
+            int y = (int)(85f + (float)(i * 56) * Scale + 20f);
+            UIGameItemSlot coin = new UIGameItemSlot(() => Main.player[Main.myPlayer].inventory, 50 + i, 1);
+            coin.Place(new Vector2(497f, y), Scale);
+            Append(coin);
+            UIGameItemSlot ammo = new UIGameItemSlot(() => Main.player[Main.myPlayer].inventory, 54 + i, 2);
+            ammo.Place(new Vector2(534f, y), Scale);
+            Append(ammo);
+        }
+    }
+
+}
+
+/// <summary>The trash slot (context 6); lower and smaller while a chest or shop is open.</summary>
+public class UITrashSlot : UIGameScreen
+{
+    private UIGameItemSlot _slot;
+
+    private bool _chestLayout;
+
+    public override void OnInitialize()
+    {
+        _slot = new UIGameItemSlot(() => Main.player[Main.myPlayer].trashItem, delegate(Item item)
+        {
+            Main.player[Main.myPlayer].trashItem = item;
+        }, 6);
+        _chestLayout = !Main.ChestOrShopUIVisible;
+        Append(_slot);
+    }
+
+    public override void UpdateState()
+    {
+        bool chestLayout = Main.ChestOrShopUIVisible;
+        if (chestLayout != _chestLayout)
+        {
+            _chestLayout = chestLayout;
+            _slot.Place(chestLayout ? new Vector2(453f, 426f) : new Vector2(448f, 258f), chestLayout ? 0.755f : 0.85f);
+            _slot.Recalculate();
+        }
+    }
+}
