--- /dev/null
+++ b/Aether/Modding/ItemSave.cs
@@ -0,0 +1,230 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using System.Text.Json;
+using Terraria;
+using Terraria.ID;
+
+namespace Aether.Modding;
+
+internal sealed class ContentSaveException(string message) : IOException(message);
+
+internal static class ItemSave
+{
+    private static ReadOnlySpan<byte> Magic => "AETHSAVE"u8;
+    private const byte Version = 1;
+    private const int MaxItems = 500_000;
+    private const int MaxStateBytes = 16 * 1024;
+    private const int MaxStateTotal = 64 * 1024 * 1024;
+
+    internal enum Kind : byte { Player = 1, World = 2 }
+
+    internal readonly record struct Entry(string Id, string State);
+
+    internal sealed class Writer(Stream stream) : BinaryWriter(stream)
+    {
+        internal readonly List<Entry> Items = new List<Entry>();
+    }
+
+    internal sealed class Reader(Stream stream, Entry[] items) : BinaryReader(stream)
+    {
+        private int _next;
+
+        internal void ReadState(Item item, string id)
+        {
+            if (_next == items.Length || items[_next].Id != id)
+            {
+                throw new ContentSaveException($"Saved item identity does not match '{id}'.");
+            }
+            item.AetherState = items[_next++].State;
+        }
+
+        internal void Finish()
+        {
+            if (_next != items.Length)
+            {
+                throw new ContentSaveException("The custom item table has unused entries.");
+            }
+        }
+    }
+
+    internal sealed class Payload(Stream stream, Entry[] items = null) : IDisposable
+    {
+        internal Stream Stream { get; } = stream;
+
+        internal BinaryReader Read(Stream decoded = null) => items == null
+            ? new BinaryReader(decoded ?? Stream) : new Reader(decoded ?? Stream, items);
+
+        public void Dispose() => Stream.Dispose();
+    }
+
+    internal static void WriteType(BinaryWriter writer, Item item, bool shortId = false)
+    {
+        if (shortId)
+        {
+            writer.Write((short)item.type);
+        }
+        else
+        {
+            writer.Write(item.type);
+        }
+        if (writer is Writer state && item.type >= ItemID.VanillaCount)
+        {
+            state.Items.Add(new Entry(GetId(item.type), item.AetherState));
+        }
+    }
+
+    internal static void ReadType(BinaryReader reader, Item item, bool shortId = false) =>
+        ReadType(reader, item, shortId ? reader.ReadInt16() : reader.ReadInt32());
+
+    internal static void ReadType(BinaryReader reader, Item item, int type)
+    {
+        item.netDefaults(type);
+        if (reader is Reader state && type >= ItemID.VanillaCount)
+        {
+            state.ReadState(item, GetId(type));
+        }
+    }
+
+    private static string GetId(int type)
+    {
+        int index = type - ItemID.VanillaCount;
+        if ((uint)index >= (uint)ClientContent.Items.Count)
+        {
+            throw new ContentSaveException($"Custom item type {type} is unavailable.");
+        }
+        return ClientContent.Items[index].Id;
+    }
+
+    internal static Payload Open(Stream source, Kind kind)
+    {
+        bool wrapped = false;
+        try
+        {
+            Span<byte> magic = stackalloc byte[8];
+            int count = source.ReadAtLeast(magic, magic.Length, false);
+            if (count != magic.Length || !magic.SequenceEqual(Magic))
+            {
+                source.Position = 0;
+                return new Payload(source);
+            }
+            wrapped = true;
+            using BinaryReader reader = new BinaryReader(source, Encoding.UTF8, leaveOpen: true);
+            if (reader.ReadByte() != Version || reader.ReadByte() != (byte)kind)
+            {
+                throw new ContentSaveException("This Aether save format or file type is unsupported.");
+            }
+            string profile = ReadString(reader, 64);
+            if (profile != ClientContent.SaveIdentity)
+            {
+                throw new ContentSaveException("This save requires the custom item profile that created it.");
+            }
+            int itemCount = reader.ReadInt32();
+            if (itemCount < 0 || itemCount > MaxItems)
+            {
+                throw new ContentSaveException("Invalid custom item table size.");
+            }
+            Entry[] items = new Entry[itemCount];
+            long start = source.Position;
+            for (int index = 0; index < itemCount; index++)
+            {
+                string id = ReadString(reader, 1024);
+                string state = ReadString(reader, MaxStateBytes);
+                if (source.Position - start > MaxStateTotal)
+                {
+                    throw new ContentSaveException("The custom item table is too large.");
+                }
+                if (state.Length != 0)
+                {
+                    using JsonDocument document = JsonDocument.Parse(state);
+                }
+                items[index] = new Entry(id, state.Length == 0 ? null : state);
+            }
+            var payload = new MemoryStream();
+            source.CopyTo(payload);
+            payload.Position = 0;
+            source.Dispose();
+            return new Payload(payload, items);
+        }
+        catch (Exception exception) when (wrapped && exception is EndOfStreamException or JsonException)
+        {
+            source.Dispose();
+            throw new ContentSaveException("The Aether save header is truncated or contains invalid item state.");
+        }
+        catch
+        {
+            source.Dispose();
+            throw;
+        }
+    }
+
+    internal static void Write(string path, Kind kind, Writer state, byte[] payload)
+    {
+        if (state.Items.Count > MaxItems)
+        {
+            throw new ContentSaveException("Too many custom items to save.");
+        }
+        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(path)));
+        string temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            using (var stream = new FileStream(temporary, FileMode.CreateNew))
+            using (var writer = new BinaryWriter(stream))
+            {
+                writer.Write(Magic);
+                writer.Write(Version);
+                writer.Write((byte)kind);
+                WriteString(writer, ClientContent.SaveIdentity, 64);
+                writer.Write(state.Items.Count);
+                long start = stream.Position;
+                foreach (Entry entry in state.Items)
+                {
+                    WriteString(writer, entry.Id, 1024);
+                    WriteString(writer, entry.State ?? "", MaxStateBytes);
+                    if (stream.Position - start > MaxStateTotal)
+                    {
+                        throw new ContentSaveException("The custom item table is too large.");
+                    }
+                }
+                writer.Write(payload);
+                stream.Flush(flushToDisk: true);
+            }
+            if (File.Exists(path))
+            {
+                File.Copy(path, path + ".bak", overwrite: true);
+            }
+            File.Move(temporary, path, overwrite: true);
+        }
+        finally
+        {
+            File.Delete(temporary);
+        }
+    }
+
+    private static string ReadString(BinaryReader reader, int maxBytes)
+    {
+        int length = reader.ReadInt32();
+        if (length < 0 || length > maxBytes)
+        {
+            throw new ContentSaveException("Invalid string size in the custom item table.");
+        }
+        byte[] bytes = reader.ReadBytes(length);
+        if (bytes.Length != length)
+        {
+            throw new EndOfStreamException();
+        }
+        return Encoding.UTF8.GetString(bytes);
+    }
+
+    private static void WriteString(BinaryWriter writer, string value, int maxBytes)
+    {
+        byte[] bytes = Encoding.UTF8.GetBytes(value);
+        if (bytes.Length > maxBytes)
+        {
+            throw new ContentSaveException("A custom item ID or state exceeds the save limit.");
+        }
+        writer.Write(bytes.Length);
+        writer.Write(bytes);
+    }
+}
