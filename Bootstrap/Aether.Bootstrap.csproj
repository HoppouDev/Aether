<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <AetherProjectMetadata>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../pyproject.toml'))</AetherProjectMetadata>
    <Version>$([System.Text.RegularExpressions.Regex]::Match('$(AetherProjectMetadata)', '(?m)^version\s*=\s*"([^"]+)"').Groups[1].Value)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Terraria.csproj" />
    <ProjectReference Include="../Modding/Aether.Modding.csproj" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <Target Name="WriteAetherVersion" BeforeTargets="AssignTargetPaths">
    <WriteLinesToFile File="$(IntermediateOutputPath)Aether.version" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)Aether.version" TargetPath="Aether.version"
        CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
