# Game code and data are never committed; only patches/ is.
# src/ is the editable decompiled tree; its AGENTS.md docs are ours and stay tracked.
src/**
!src/**/
!src/**/AGENTS.md
# Pristine decompiled base, extracted DLLs and local tool state, all regenerated by ./aether setup
.base/
lib/
.aether/
*.rej
*.orig

# Build output
bin/
obj/
*.pdb

# Python (uv project for tools/aether)
.venv/
__pycache__/
.pytest_cache/
.rumdl_cache/
*.egg-info/

# NuGet
/packages/
*.nupkg
project.lock.json

# IDEs and editors
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.sln.DotSettings.user
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs and crash dumps
*.log
*.dmp

# Local game runs (symlinked game dirs, save directories)
/run/
/saves/

# Nothing under patches/ may ever be ignored, or edits would silently go uncommitted.
!/patches/**/
!/patches/**

# Self-contained per-target builds (`aether build --target`): they contain game files.
/dist/
