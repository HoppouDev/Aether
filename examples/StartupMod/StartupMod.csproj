<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aether.Examples.StartupMod</AssemblyName>
    <GameVersion Condition="'$(GameVersion)' == ''">1.4.5.8</GameVersion>
    <AetherClientDirectory Condition="'$(AetherClientDirectory)' == ''">../../Bootstrap/bin/Debug/net10.0</AetherClientDirectory>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Support/**/*.cs" />
    <ProjectReference Include="Support/Support.csproj" />
    <Reference Include="Aether.Modding" HintPath="$(AetherClientDirectory)/Aether.Modding.dll" Private="false" />
    <Reference Include="Terraria" HintPath="$(AetherClientDirectory)/Terraria.dll" Private="false" />
  </ItemGroup>
  <Target Name="PackMod" DependsOnTargets="Build">
    <PropertyGroup>
      <ModStaging>$(IntermediateOutputPath)package</ModStaging>
      <ModArchive>$(TargetDir)StartupMod.aethermod</ModArchive>
    </PropertyGroup>
    <RemoveDir Directories="$(ModStaging)" />
    <MakeDir Directories="$(ModStaging)" />
    <ItemGroup>
      <ModFiles Include="$(TargetPath);$(TargetDir)$(AssemblyName).deps.json;$(TargetDir)Aether.Examples.StartupSupport.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModStaging)" />
    <WriteLinesToFile File="$(ModStaging)/aether.mod.json" Overwrite="true"
      Lines="{ &quot;schemaVersion&quot;: 1, &quot;id&quot;: &quot;startup-example&quot;, &quot;version&quot;: &quot;1.0.0&quot;, &quot;gameVersion&quot;: &quot;$(GameVersion)&quot;, &quot;assembly&quot;: &quot;$(AssemblyName).dll&quot;, &quot;entrypoint&quot;: &quot;Aether.Examples.Startup&quot;, &quot;mixins&quot;: [ &quot;Aether.Examples.StartupMixin&quot; ] }" />
    <ZipDirectory SourceDirectory="$(ModStaging)" DestinationFile="$(ModArchive)" Overwrite="true" />
  </Target>
</Project>
